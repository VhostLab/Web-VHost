---
// src/components/sections/home/HeroSlider.astro
// Los slides se renderizan en servidor para que el contenido (h1, features,
// CTAs) sea HTML estático rastreable. La rotación la gestiona un script
// vanilla (sin Alpine): crossfade por clases + pausa al hacer hover.

const slides = [
  {
    bg: "/images/inicio/hero/nether.webp",
    title: "Minecraft Hosting",
    features: [
      "Soporte Java & Bedrock Edition",
      "Protección Anti-DDoS incluida",
      "Slots ilimitados para jugadores",
      "Panel de control Pterodactyl",
    ],
    btn: { text: "Ver servidores Minecraft »", link: "/tienda/minecraft" },
  },
  {
    bg: "/images/tienda/hytale/hytale-wallpaper.jpg",
    title: "Hytale Hosting",
    features: [
      "Pre-reserva tu servidor hoy",
      "Ryzen 5 9600X",
      "Soporte total para Scripting",
      "Protección Anti-DDoS Game",
    ],
    btn: { text: "Ver servidores Hytale »", link: "/tienda/hytale" },
  },
  {
    bg: "/images/inicio/hero/ts-bg.webp",
    title: "TeamSpeak 3 Hosting",
    features: [
      "Calidad de audio cristalina HD",
      "Servidores ubicados en Francia, París",
      "Panel web completo incluido",
      "Uptime garantizado 99.9%",
    ],
    btn: { text: "Ver servidores TS3 »", link: "/tienda/teamspeak3" },
  },
];

const headingClasses =
  "text-2xl sm:text-3xl md:text-5xl lg:text-6xl font-poppins font-bold mb-4 sm:mb-6 md:mb-8 leading-tight";
---

<section
  data-hero-slider
  data-hero-count={slides.length}
  class="relative w-full h-[500px] sm:h-[550px] md:h-[600px] bg-black/80 overflow-hidden"
  style="min-height: 420px; max-width: 100vw;"
>
  {
    slides.map((slide, i) => (
      <div
        data-hero-slide={i}
        class:list={[
          "absolute inset-0 w-full h-full bg-cover bg-center z-0 transition-opacity duration-500",
          i > 0 && "opacity-0",
        ]}
        style={`background-image: url('${slide.bg}')`}
      />
    ))
  }
  <div class="absolute inset-0 bg-black/70 z-0"></div>
  <div
    class="absolute inset-0 pointer-events-none z-0"
    style="background: linear-gradient(to right, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.9) 50%, rgba(0,0,0,0.6) 60%, rgba(0,0,0,0.3) 80%, rgba(0,0,0,0) 100%);"
  >
  </div>

  <div
    class="relative container mx-auto px-6 sm:px-8 md:px-10 lg:px-12 h-full flex items-center z-10"
  >
    {
      slides.map((slide, i) => (
        <div
          data-hero-slide={i}
          data-hero-content
          class:list={[
            "absolute inset-0 flex items-center px-6 sm:px-8 md:px-10 lg:px-12 transition-opacity duration-500",
            i > 0 && "opacity-0 pointer-events-none",
          ]}
          style="z-index: 10;"
        >
          <div class="w-full md:w-3/4 lg:w-2/3 max-w-4xl">
            <p class="text-xs sm:text-sm md:text-base lg:text-lg font-poppins uppercase text-secondary mb-2 md:mb-3">
              Adquiere ahora
            </p>
            {i === 0 ? (
              <h1 class={headingClasses}>{slide.title}</h1>
            ) : (
              <h2 class={headingClasses}>{slide.title}</h2>
            )}

            <div class="mb-6 sm:mb-8 md:mb-10">
              <ul class="space-y-2 sm:space-y-3 md:space-y-4">
                {slide.features.map((feature) => (
                  <li class="flex items-start space-x-2 sm:space-x-3">
                    <span class="text-secondary text-lg sm:text-xl md:text-2xl font-bold flex-shrink-0 mt-0.5">
                      ✓
                    </span>
                    <span class="text-xs sm:text-sm md:text-lg text-gray-200 leading-relaxed">
                      {feature}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-4 sm:mt-6 md:mt-8">
              <a
                href={slide.btn.link}
                class="btn-primary text-xs sm:text-sm md:text-base"
              >
                {slide.btn.text}
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <button
    data-hero-prev
    aria-label="Anterior"
    class="hidden md:block absolute top-1/2 left-8 -translate-y-1/2 z-20 p-0 bg-transparent border-none outline-none hover:scale-110 transition"
    style="box-shadow: none;"
  >
    <svg
      class="w-8 h-8 text-white"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
      ></path>
    </svg>
  </button>
  <button
    data-hero-next
    aria-label="Siguiente"
    class="hidden md:block absolute top-1/2 right-8 -translate-y-1/2 z-20 p-0 bg-transparent border-none outline-none hover:scale-110 transition"
    style="box-shadow: none;"
  >
    <svg
      class="w-8 h-8 text-white"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
      ></path>
    </svg>
  </button>
</section>

<script>
  const slider = document.querySelector<HTMLElement>("[data-hero-slider]");

  if (slider) {
    const slides = [
      ...slider.querySelectorAll<HTMLElement>("[data-hero-slide]"),
    ];
    const count = Number(slider.dataset.heroCount);
    let active = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const render = () => {
      for (const el of slides) {
        const inactive = Number(el.dataset.heroSlide) !== active;
        el.classList.toggle("opacity-0", inactive);
        if (el.dataset.heroContent !== undefined) {
          el.classList.toggle("pointer-events-none", inactive);
        }
      }
    };

    const next = () => {
      active = (active + 1) % count;
      render();
    };
    const prev = () => {
      active = (active - 1 + count) % count;
      render();
    };
    const start = () => {
      if (!timer) timer = setInterval(next, 5000);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    slider.addEventListener("mouseenter", stop);
    slider.addEventListener("mouseleave", start);
    slider.querySelector("[data-hero-prev]")?.addEventListener("click", prev);
    slider.querySelector("[data-hero-next]")?.addEventListener("click", next);
    start();
  }
</script>
