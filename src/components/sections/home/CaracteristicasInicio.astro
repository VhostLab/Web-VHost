---
export interface Caracteristica {
  icon: string;
  title: string;
  description: string;
  proof: string;
}

const caracteristicas: Caracteristica[] = [
  {
    icon: "fas fa-server",
    title: "Hardware Empresarial",
    description:
      "Rendimiento fluido garantizado con hardware profesional de última generación.",
    proof: "NVMe + CPUs de alto rendimiento",
  },
  {
    icon: "fas fa-coins",
    title: "Económico",
    description:
      "Precios asequibles y transparentes adaptados para cualquier tipo de presupuesto.",
    proof: "Desde 0,75 €/mes",
  },
  {
    icon: "fas fa-headset",
    title: "Soporte 24/7",
    description:
      "Asistencia técnica inmediata y experta ante cualquier incidencia disponible 24/7.",
    proof: "En español, por Discord y tickets",
  },
  {
    icon: "fas fa-globe",
    title: "Baja Latencia",
    description:
      "Red global de servidores con conexiones optimizadas para máxima velocidad.",
    proof: "Nodos en Logroño y Barcelona",
  },
  {
    icon: "fas fa-bolt",
    title: "Activación Instantánea",
    description:
      "Tu servidor desplegado y listo para usar segundos después de confirmar el pago.",
    proof: "Online en segundos, sin esperas",
  },
  {
    icon: "fas fa-shield-alt",
    title: "Protección DDoS",
    description:
      "Blindaje perimetral automático ante ataques malintencionados sin coste añadido.",
    proof: "Incluida en todos los planes",
  },
];
---

<section class="py-20 md:py-24 bg-primary">
  <div class="container mx-auto px-4 sm:px-6">
    <h2
      class="text-3xl sm:text-4xl md:text-5xl font-poppins font-bold text-white text-center mb-4"
    >
      ¿Por qué elegirnos?
    </h2>
    <div class="border-t-2 border-secondary w-24 mx-auto mb-4"></div>
    <p class="text-slate-400 text-center max-w-2xl mx-auto mb-12 md:mb-16">
      Seis razones que incluiremos en tu servidor de forma predeterminada, sin
      costes ocultos ni sorpresas.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {
        caracteristicas.map((item, index) => (
          <div
            class="feature-card group relative flex flex-col p-7 rounded-2xl bg-white/5 border border-white/10 transition-[border-color,transform,box-shadow] duration-150 ease-out hover:border-secondary/50 hover:-translate-y-1 hover:bg-white/[0.07]"
          >
            {/* Número de serie: facilita el escaneo y ancla el orden de lectura */}
            <span
              class="absolute top-5 right-6 text-sm font-semibold text-white/15 font-poppins select-none"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>

            {/* Icono con acento unificado de marca */}
            <div class="icon-wrapper w-12 h-12 rounded-xl flex items-center justify-center mb-5 transition-transform duration-150 ease-out group-hover:scale-110">
              <i class={`${item.icon} text-lg text-secondary`} />
            </div>

            <h3 class="text-lg font-bold text-white mb-2 transition-colors duration-150 group-hover:text-secondary">
              {item.title}
            </h3>
            <p class="text-slate-400 leading-relaxed text-[15px] mb-4">
              {item.description}
            </p>

            {/* Prueba concreta: ancla numérica o dato verificable */}
            <p class="mt-auto pt-3 border-t border-white/10 text-[13px] font-medium text-slate-300">
              <i class="fas fa-check text-secondary mr-2 text-xs" />
              {item.proof}
            </p>
          </div>
        ))
      }
    </div>

  </div>
</section>

<style>
  .icon-wrapper {
    background-color: rgba(252, 124, 4, 0.12);
    border: 1px solid rgba(252, 124, 4, 0.25);
  }
</style>
