---
// CTA final de conversión — banda full-width con gradiente, reutilizable
interface Props {
  eyebrow?: string;
  title?: string;
  titleHighlight?: string;
  description?: string;
  href?: string;
  ctaSmall?: string;
  ctaLabel?: string;
}

const {
  eyebrow = "Crea tu servidor",
  title = "¿Listo para",
  titleHighlight = "comenzar?",
  description = "Elige tu juego, confirma el pago y recibe los datos de acceso al panel en minutos. Desde 0,75 €/mes, sin permanencia y con soporte 24/7.",
  href = "https://billing.vhost.tech",
  ctaSmall = "Tu servidor",
  ctaLabel = "Activo en minutos",
} = Astro.props;
---

<section class="cta-band w-full relative overflow-hidden border-y border-white/5">
  <div
    class="container mx-auto px-4 sm:px-6 py-8 md:py-10 flex flex-col lg:flex-row items-start lg:items-center gap-6 lg:gap-10"
  >
    <div class="flex-1 min-w-0">
      <p
        class="text-secondary uppercase tracking-[0.2em] text-xs md:text-sm font-poppins font-semibold mb-2"
      >
        {eyebrow}
      </p>
      <h2
        class="text-3xl md:text-4xl font-poppins font-extrabold uppercase text-white leading-tight"
      >
        {title} <span class="text-secondary">{titleHighlight}</span>
      </h2>
      <p class="text-gray-300 text-sm md:text-base leading-relaxed mt-2 max-w-2xl">
        {description}
      </p>
    </div>

    <a
      href={href}
      class="cta-button group inline-flex items-center gap-4 flex-shrink-0 rounded-2xl bg-secondary px-6 py-3.5 transition-transform duration-150 ease-out hover:scale-[1.03] active:scale-[0.98]"
    >
      <span
        class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center flex-shrink-0"
      >
        <i class="fas fa-bolt text-white"></i>
      </span>
      <span class="text-left leading-tight">
        <span class="block text-white/75 uppercase tracking-wider text-[11px] font-poppins font-semibold">
          {ctaSmall}
        </span>
        <span class="block text-white uppercase font-poppins font-extrabold text-base md:text-lg">
          {ctaLabel}
        </span>
      </span>
      <i
        class="fas fa-angle-double-right text-white text-lg transition-transform duration-150 group-hover:translate-x-1"
      ></i>
    </a>
  </div>
</section>

<style>
  .cta-band {
    background:
      radial-gradient(
        ellipse 50% 130% at 85% 50%,
        rgba(252, 124, 4, 0.08),
        transparent 70%
      ),
      #0b0b0b;
  }

  .cta-button:focus-visible {
    outline: 2px solid #fc7c04;
    outline-offset: 3px;
  }
</style>
