---
export interface FAQ {
  question: string;
  answer: string;
}

export interface Props {
  items: FAQ[];
  inviteLink: string;
  backgroundClass?: string;
}

const { items, inviteLink, backgroundClass } = Astro.props as Props;
---

<!-- Sección única responsive: 1 columna en móvil, 2 en escritorio -->
<section class={`faq-section py-20 md:py-24 ${backgroundClass ?? 'bg-[#0b0b0b]'}`}>
  <div class="max-w-4xl mx-auto px-4 md:px-0 md:rounded-lg md:shadow-xl md:overflow-hidden">
    <!-- Header -->
    <div class="md:bg-[#161616] text-white text-center py-0 md:py-8">
      <h2 class="text-2xl md:text-4xl font-poppins font-bold">PREGUNTAS FRECUENTES</h2>
      <div class="border-t-2 border-secondary w-16 md:w-24 mx-auto mt-3 md:mt-4"></div>
    </div>

    <!-- Cuerpo -->
    <div class="md:bg-[#0f0f0f] px-0 md:px-6 pt-6 md:py-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4 md:gap-y-0">
        {items.map(item => (
          <details class="border-b border-secondary/50 transition-all duration-300 hover:border-secondary group">
            <summary class="flex justify-between items-center min-h-[64px] py-3 md:py-4 cursor-pointer text-white font-karla font-semibold hover:text-secondary active:text-secondary transition-colors">
              <span class="pr-2">{item.question}</span>
              <span class="faq-symbol text-xl md:text-2xl text-secondary flex-shrink-0 group-open:rotate-45 transition-transform duration-300">+</span>
            </summary>
            <div class="faq-answer px-2 md:px-0">
              <div class="pt-2 pb-4 text-muted font-inter text-sm md:text-base leading-relaxed">
                {item.answer}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>

    <!-- Footer -->
    <div class="md:bg-[#161616] text-gray-300 flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4 py-6 font-karla text-center">
      <span>¿No está tu pregunta y necesitas una respuesta rápida?</span>
      <a
        href={inviteLink}
        class="btn-secondary text-sm py-2 px-4"
      >
        Únete a nuestro Discord
      </a>
    </div>
  </div>

  <style>
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    details[open] .faq-answer {
      max-height: 500px;
    }
  </style>

  <script type="module" src="/scripts/faq-toggle.js"></script>
</section>
