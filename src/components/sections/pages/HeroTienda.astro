---
// Hero de las páginas de tienda — breadcrumb, ancla de precio, chips de confianza y CTA a planes
// Tratamiento V3: imagen atenuada + glow naranja bajo el CTA; chips estilo V2
export interface Props {
  titulo?: string;
  descripcion?: string;
  imagenFondo?: string; // Ruta de la imagen de fondo
  precioDesde?: string; // Ancla de precio, p. ej. "0,75 €/mes" (opcional; sin él no se muestra la pill)
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  titulo = "Minecraft Hosting",
  descripcion = "",
  imagenFondo = "/images/aquatic.webp",
  precioDesde,
  ctaLabel = "Ver planes",
  ctaHref = "#planes",
} = Astro.props as Props;

// Breadcrumb automático: Inicio → Tienda → página actual
const esCatalogo = titulo === "Tienda";
const breadcrumb = [
  { name: "Inicio", href: "/" },
  { name: "Tienda", href: "/tienda/tienda" },
  ...(esCatalogo ? [] : [{ name: titulo, href: "" }]),
];

const chips = [
  { icon: "fas fa-shield-alt", text: "Anti-DDoS incluido" },
  { icon: "fas fa-bolt", text: "Activación instantánea" },
  { icon: "fas fa-headset", text: "Soporte 24/7 en español" },
];
---

<section
  class="relative bg-cover bg-center overflow-hidden"
  style={`background-image: url('${imagenFondo}');`}
>
  <!-- Atenuado base (más suave que el negro plano) -->
  <div class="absolute inset-0 bg-black/45"></div>
  <!-- Glow naranja de marca bajo el CTA -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 45% 80% at 78% 65%, rgba(252,124,4,0.22), transparent 70%);"
  ></div>
  <!-- Fundido hacia la zona de texto -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(
      to right,
      rgba(8,8,10,0.88) 0%,
      rgba(8,8,10,0.55) 45%,
      rgba(8,8,10,0.15) 75%
    );"
  ></div>

  <div class="relative container mx-auto px-6 pt-6 pb-16 md:pb-20 text-white">
    <!-- Breadcrumb: contexto de navegación -->
    <nav
      class="mb-6 flex items-center gap-2 text-xs text-gray-300"
      aria-label="Migas de pan"
    >
      {
        breadcrumb.map((item, i) => (
          <span class="flex items-center gap-2">
            {i > 0 && <i class="fas fa-chevron-right text-[8px] text-gray-500" />}
            {item.href ? (
              <a href={item.href} class="hover:text-secondary transition-colors duration-150">
                {item.name}
              </a>
            ) : (
              <span class="text-white" aria-current="page">
                {item.name}
              </span>
            )}
          </span>
        ))
      }
    </nav>

    <div class="max-w-xl">
      <!-- Ancla de precio: el dato clave, escaneable sin leer -->
      {
        precioDesde && (
          <p class="inline-flex items-center gap-2 bg-secondary/20 backdrop-blur-sm border border-secondary/50 text-secondary rounded-full px-3.5 py-1 text-sm font-poppins font-semibold mb-4">
            <i class="fas fa-tag text-xs" />
            desde {precioDesde}
          </p>
        )
      }

      <h1 class="text-5xl md:text-6xl font-poppins font-bold mb-5 drop-shadow-lg">
        {titulo}
      </h1>

      {descripcion && (
        <p class="text-lg font-poppins text-gray-100 leading-relaxed mb-5 drop-shadow">
          {descripcion}
        </p>
      )}

      <!-- Chips de confianza estilo V2 -->
      <ul class="flex flex-wrap gap-2 mb-7">
        {
          chips.map((chip) => (
            <li class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-lg px-3 py-1.5 text-sm text-gray-200">
              <i class={`${chip.icon} text-secondary text-xs`} />
              {chip.text}
            </li>
          ))
        }
      </ul>

      <a
        href={ctaHref}
        class="hero-cta inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-secondary text-white font-poppins font-semibold text-base transition-transform duration-150 ease-out hover:scale-[1.03] active:scale-[0.98] w-full sm:w-auto shadow-[0_8px_30px_-6px_rgba(252,124,4,0.55)]"
      >
        {ctaLabel}
        <i class="fas fa-arrow-down text-sm" />
      </a>
    </div>
  </div>
</section>

<style>
  .hero-cta:focus-visible {
    outline: 2px solid #fc7c04;
    outline-offset: 3px;
  }
</style>
