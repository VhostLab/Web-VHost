              </li>
              <li>
                <a
                  href="https://discord.gg/Ykr85wevrj"
                  target="_blank"
                  class="block py-2 pl-4 text-sm text-white border-b border-secondary/10 hover:bg-white/10"
                  >Discord</a
                >
              </li>
            </ul>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <script>
    // Efecto sticky header con blur y transparencia al hacer scroll
    let lastScroll = 0;
    const header = document.getElementById("main-header");
    const mainNav = document.getElementById("main-nav");
    const socialBar = document.getElementById("social-bar");

    window.addEventListener("scroll", () => {
      const currentScroll = window.pageYOffset;

      if (currentScroll > 50) {
        // Cuando scroll > 50px: ocultar social bar, añadir blur y sombra
        if (socialBar) socialBar.style.display = "none";
        if (mainNav) {
          mainNav.style.backdropFilter = "blur(10px)";
          mainNav.style.backgroundColor = "rgba(252, 124, 4, 0.95)";
          mainNav.style.boxShadow = "0 4px 20px rgba(0, 0, 0, 0.3)";
        }
      } else {
        // Cuando scroll < 50px: mostrar social bar, remover blur
        if (socialBar) socialBar.style.display = "block";
        if (mainNav) {
          mainNav.style.backdropFilter = "none";
          mainNav.style.backgroundColor = "";
          mainNav.style.boxShadow = "none";
        }
      }

      lastScroll = currentScroll;
    });

    // Menú móvil
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    let menuOpen = false;

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener("click", (e) => {
        e.stopPropagation();
        menuOpen = !menuOpen;

        if (menuOpen) {
          // Altura real del contenido: con una cifra fija, al añadir una
          // pestaña más el menú se cortaba por abajo sin que nadie se diera cuenta.
          mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
          mobileMenu.style.paddingTop = "8px";
          mobileMenu.style.paddingBottom = "8px";
        } else {
          mobileMenu.style.maxHeight = "0px";
          mobileMenu.style.paddingTop = "0px";
          mobileMenu.style.paddingBottom = "0px";
        }
      });

      // Cerrar menú al hacer clic en un enlace (excepto los botones de submenú)
      const menuLinks = mobileMenu.querySelectorAll("a");
      menuLinks.forEach((link) => {
        link.addEventListener("click", () => {
          menuOpen = false;
          mobileMenu.style.maxHeight = "0px";
          mobileMenu.style.paddingTop = "0px";
          mobileMenu.style.paddingBottom = "0px";
        });
      });
    }

    // Submenús móviles (Tienda, Utilidades, Clientes).
    //
    // Un único bloque para todos: antes había uno copiado por menú, cada uno
    // con su altura máxima escrita a mano, así que añadir una pestaña obligaba
    // a duplicar código y a acertar un número. Ahora la altura se mide del
    // contenido y añadir un submenú es solo poner data-submenu en el botón.
    const submenus = document.querySelectorAll("[data-submenu]");

    submenus.forEach((toggle) => {
      const nombre = toggle.getAttribute("data-submenu");
      const submenu = document.getElementById(`mobile-${nombre}-submenu`);
      const flecha = document.getElementById(`mobile-${nombre}-arrow`);
      if (!submenu) return;

      // El menú padre recorta lo que sobresale, así que al abrir un submenú hay
      // que ampliarlo o el último enlace queda cortado. No se puede medir el
      // padre en el momento del clic porque el submenú aún está a cero y sigue
      // animándose: primero se le da una cota amplia y luego, cuando la
      // transición acaba, se ajusta a la altura real.
      const ajustarPadre = () => {
        if (mobileMenu && menuOpen) {
          mobileMenu.style.maxHeight = `${mobileMenu.scrollHeight}px`;
        }
      };
      submenu.addEventListener("transitionend", ajustarPadre);

      toggle.addEventListener("click", () => {
        const cerrado =
          submenu.style.maxHeight === "0px" || submenu.style.maxHeight === "";
        const alto = submenu.scrollHeight;
        submenu.style.maxHeight = cerrado ? `${alto}px` : "0px";
        if (flecha) {
          flecha.style.transform = cerrado ? "rotate(180deg)" : "rotate(0deg)";
        }
        if (cerrado && mobileMenu && menuOpen) {
          mobileMenu.style.maxHeight = `${mobileMenu.scrollHeight + alto}px`;
        }
      });
    });

  </script>

  <style>
    /* Active state para navegación */
    nav a[href]:not([target="_blank"]) {
      position: relative;
    }

    nav a[href]:not([target="_blank"])::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 2px;
      background: white;
      transition: width 0.3s ease;
    }

    nav a[href]:not([target="_blank"]):hover::after {
      width: 100%;
    }
  </style>
</header>
