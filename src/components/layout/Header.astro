---
import vhostLogo from "/src/images/vhosthostingservices.webp";
import discordIcon from "/src/images/discord-icon.webp";
import twitterIcon from "/src/images/twitter-icon.webp";
import emailIcon from "/src/images/email-icon.webp";
import Icono from "@components/utilidades/Icono.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 transition-all duration-300" id="main-header">
  <div class="bg-primary py-2 transition-all duration-300" id="social-bar">
    <div class="container mx-auto flex justify-center md:justify-start px-6">
      <div class="flex space-x-3">
        <a
          href="https://discord.gg/Ykr85wevrj"
          class="group"
          aria-label="Discord"
        >
          <img
            src={discordIcon.src}
            alt="Discord"
            class="h-4 w-4 filter brightness-0 invert transition duration-200 group-hover:invert-0 group-hover:brightness-75 group-hover:sepia group-hover:saturate-200 group-hover:hue-rotate-15"
          />
        </a>
        <a href="https://x.com/VhostTS3" class="group" aria-label="Twitter">
          <img
            src={twitterIcon.src}
            alt="Twitter"
            class="h-4 w-4 filter brightness-0 invert transition duration-200 group-hover:invert-0 group-hover:brightness-75 group-hover:sepia group-hover:saturate-200 group-hover:hue-rotate-15"
          />
        </a>
        <a href="mailto:vhostts3@gmail.com" class="group" aria-label="Email">
          <img
            src={emailIcon.src}
            alt="Email"
            class="h-4 w-4 filter brightness-0 invert transition duration-200 group-hover:invert-0 group-hover:brightness-75 group-hover:sepia group-hover:saturate-200 group-hover:hue-rotate-15"
          />
        </a>
      </div>
    </div>
  </div>

  <div class="bg-secondary transition-all duration-300" id="main-nav">
    <div
      class="container mx-auto flex items-center justify-between py-4 px-6 lg:px-12"
    >
      <a href="/" class="block">
        <img src={vhostLogo.src} alt="VHost Logo" class="h-14 w-auto" />
      </a>

      <button
        id="mobile-menu-button"
        class="lg:hidden text-white focus:outline-none"
        aria-label="Abrir menú"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>

      <nav class="hidden lg:flex items-center space-x-6">
        <ul class="flex space-x-2 items-center">
          <li>
            <a
              href="/"
              class="text-lg font-poppins font-bold text-white px-3 py-1 inline-flex items-center"
              >INICIO</a
            >
          </li>

          <li class="relative group" tabindex="0">
            <button
              class="text-lg font-poppins font-bold text-white px-3 py-1 flex items-center focus:outline-none group-hover:text-primary transition-colors duration-200"
              aria-haspopup="true"
              aria-expanded="false"
            >
              TIENDA
              <svg
                class="w-4 h-4 ml-1 transition-transform duration-200 group-hover:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <div
              class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-[760px] bg-[#151515] border border-white/10 rounded-xl shadow-2xl z-50 invisible opacity-0 translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 hover:visible hover:opacity-100 hover:translate-y-0 focus-within:visible focus-within:opacity-100 focus-within:translate-y-0 transition-all duration-300 ease-in-out p-6 origin-top"
            >
              <div class="flex gap-6">
                <div class="flex-[2]">
                  <h4
                    class="text-xs uppercase text-gray-500 font-bold mb-3 tracking-wider"
                  >
                    Game Hosting
                  </h4>

                  <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col space-y-2">
                      <a
                        href="/tienda/minecraft"
                        class="flex items-center p-2 rounded-lg hover:bg-white/5 transition group/item"
                      >
                        <div
                          class="w-8 h-8 rounded bg-green-900/30 text-green-500 flex items-center justify-center mr-3 shrink-0"
                        >
                          <i class="fas fa-cube"></i>
                        </div>
                        <div>
                          <div
                            class="text-sm font-bold text-white group-hover/item:text-[#fc7c04] transition-colors"
