              class="w-full flex items-center justify-between py-3 text-white font-bold border-b border-secondary/10"
            >
              TIENDA
              <svg
                class="w-4 h-4 transition-transform"
                id="mobile-tienda-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <ul
              id="mobile-tienda-submenu"
              class="overflow-hidden transition-all duration-300 max-h-0 bg-black/20"
            >
              <li>
                <a
                  href="/tienda/minecraft"
                  class="block py-2 pl-4 text-sm text-white hover:bg-white/10"
                  >Minecraft</a
                >
              </li>
              <li>
                <a
                  href="/tienda/hytale"
                  class="block py-2 pl-4 text-sm text-white hover:bg-white/10"
                  >Hytale</a
                >
              </li>
              <li>
                <a
                  href="/juegos"
                  class="block py-2 pl-4 text-sm text-white hover:bg-white/10 text-[#fc7c04]"
                  >Todos los juegos</a
                >
              </li>
              <li>
                <a
                  href="/tienda/teamspeak3"
                  class="block py-2 pl-4 text-sm text-white hover:bg-white/10"
                  >TeamSpeak 3</a
                >
              </li>
            </ul>
          </li>
          <li>
            <a
              href="/partners"
              class="block py-3 text-white font-bold border-b border-secondary/10"
              >PARTNERS</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="block py-3 text-white font-bold border-b border-secondary/10"
              >BLOG</a
            >
          </li>
          <li>
            <button
              id="mobile-utilidades-toggle"
              data-submenu="utilidades"
              class="w-full flex items-center justify-between py-3 text-white font-bold border-b border-secondary/10"
            >
              UTILIDADES
              <svg
                class="w-4 h-4 transition-transform"
                id="mobile-utilidades-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <ul
              id="mobile-utilidades-submenu"
              class="overflow-hidden transition-all duration-300"
              style="max-height: 0px"
            >
              <li>
                <a
                  href="/utilidades/comprobador-mods/"
                  class="block py-2 pl-4 text-sm text-white hover:bg-white/10"
                  >Comprobador de mods</a
                >
              </li>
              <li>
                <a
                  href="/utilidades/calculadora-ram/"
                  class="block py-2 pl-4 text-sm text-white hover:bg-white/10"
                  >Calculadora de RAM</a
                >
              </li>
              <li>
                <a
                  href="/utilidades/registros-dns/"
                  class="block py-2 pl-4 text-sm text-white hover:bg-white/10"
                  >Registros DNS</a
                >
              </li>
              <li>
                <a
                  href="/utilidades/"
                  class="block py-2 pl-4 text-sm text-white border-b border-secondary/10 hover:bg-white/10"
                  >Ver todas</a
                >
              </li>
            </ul>
          </li>
          <li>
            <a
              href="/soporte"
              class="block py-3 text-white font-bold border-b border-secondary/10"
              >SOPORTE</a
            >
          </li>
          <li>
            <button
              id="mobile-clientes-toggle"
              data-submenu="clientes"
              class="w-full flex items-center justify-between py-3 text-white font-bold border-b border-secondary/10"
            >
              CLIENTES
              <svg
                class="w-4 h-4 transition-transform"
                id="mobile-clientes-arrow"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
