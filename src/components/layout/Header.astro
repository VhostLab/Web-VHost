                </span>
              </a>
              <a
                href="/utilidades/registros-dns/"
                class="group/item flex items-start gap-3 rounded-lg px-3 py-2.5 hover:bg-white/5"
              >
                <Icono
                  nombre="globo"
                  tamano={18}
