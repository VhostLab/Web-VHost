                  </a>
                </li>
                <li>
                  <a
                    href="https://dashboard.vhost.tech"
                    target="_blank"
                    class="flex items-center px-4 py-2 text-sm font-semibold text-white hover:bg-white/5"
                  >
                    <i class="fas fa-gamepad w-4 h-4 mr-2"></i>Panel Juegos
                  </a>
                </li>
                <li>
                  <a
                    href="https://discord.gg/Ykr85wevrj"
                    target="_blank"
                    class="flex items-center px-4 py-2 text-sm font-semibold text-white hover:bg-white/5"
                  >
                    <i class="fab fa-discord w-4 h-4 mr-2"></i>Discord
                  </a>
                </li>
              </ul>
            </li>
          </ul>
        </ul>
      </nav>
    </div>

    <div
      id="mobile-menu"
      class="lg:hidden bg-primary/95 backdrop-blur-sm border-t border-secondary/20 overflow-hidden transition-all duration-300 max-h-0"
    >
      <nav class="container mx-auto px-6 py-0">
        <ul class="space-y-1">
          <li>
            <a
