---
// Tarjetas del bloque destacado del índice: una principal, grande, y dos
// secundarias a su lado. Solo cambian el tamaño y cuánto detalle enseñan.
export interface Props {
  url: string;
  titulo: string;
  descripcion: string;
  juego: string;
  tema: string;
  actualizado: string;
  minutos: number;
  autor?: string;
  variante?: "principal" | "secundaria";
}

const {
  url,
  titulo,
  descripcion,
  juego,
  tema,
  actualizado,
  minutos,
  autor,
  variante = "secundaria",
} = Astro.props as Props;
---

{
  variante === "principal" ? (
    <a
      href={url}
      class="flex min-h-[290px] flex-col justify-between rounded-2xl border border-[#262626] bg-gradient-to-br from-[#1a1a1a] to-[#111111] p-7 transition-colors hover:border-secondary md:p-9"
    >
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="rounded-[5px] bg-secondary px-2.5 py-[5px] font-karla text-[11px] font-semibold uppercase tracking-[0.14em] text-[#0b0b0b]">
          Imprescindible
        </span>
        <span class="font-karla text-xs text-[#8d8d8d]">
          {juego} · {tema}
        </span>
      </div>
      <div class="mt-10">
        <h2 class="max-w-[22ch] font-poppins text-[24px] font-semibold leading-[1.15] tracking-[-0.02em] text-[#f3f1ef] md:text-[32px]">
          {titulo}
        </h2>
        <p class="mt-3.5 max-w-[52ch] font-karla text-[15px] leading-relaxed text-[#9a9a9a] md:text-base">
          {descripcion}
        </p>
        <div class="mt-5 font-karla text-[13px] text-[#6f6f6f]">
          {autor} · Actualizado {actualizado} · {minutos} min
        </div>
      </div>
    </a>
  ) : (
    <a
      href={url}
      class="flex flex-col justify-between rounded-2xl border border-[#1f1f1f] bg-[#111111] p-6 transition-colors hover:border-[#3a3a3a]"
    >
      <span class="font-karla text-xs uppercase tracking-[0.1em] text-secondary">
        {juego} · {tema}
      </span>
      <div class="mt-4">
        <h3 class="font-poppins text-[19px] font-semibold leading-[1.25] text-[#f3f1ef] md:text-xl">
          {titulo}
        </h3>
        <div class="mt-3.5 font-karla text-[13px] text-[#6f6f6f]">
          Actualizado {actualizado} · {minutos} min
        </div>
      </div>
    </a>
  )
}
