---
// Tarjeta de una guía. La usan el listado del índice y el bloque de guías
// relacionadas del final de cada artículo, que enseñan lo mismo con distinto
// nivel de detalle.
//
// La variante "completa" añade además los atributos data-* que lee el script
// del índice para buscar y filtrar sin recargar la página.
export interface Props {
  url: string;
  titulo: string;
  descripcion: string;
  juego: string;
  tema: string;
  actualizado: string;
  minutos?: number;
  autor?: string;
  variante?: "completa" | "compacta";
  /** Texto sobre el que busca el índice. Si se pasa, la tarjeta es filtrable. */
  busqueda?: string;
  destacada?: boolean;
  oculta?: boolean;
}

const {
  url,
  titulo,
  descripcion,
  juego,
  tema,
  actualizado,
  minutos,
  autor,
  variante = "completa",
  busqueda,
  destacada = false,
  oculta = false,
} = Astro.props as Props;

const filtrable = busqueda !== undefined;
---

{
  variante === "completa" ? (
    <a
      href={url}
      data-entrada={filtrable ? "" : undefined}
      data-juego={filtrable ? juego : undefined}
      data-tema={filtrable ? tema : undefined}
      data-busqueda={busqueda}
      data-destacada={filtrable ? (destacada ? "1" : "0") : undefined}
      class:list={[
        "flex flex-col rounded-[14px] border border-[#1f1f1f] bg-[#111111] p-6 transition-colors hover:border-secondary hover:bg-[#161616]",
        { hidden: oculta },
      ]}
    >
      <div class="flex items-center justify-between gap-3">
        <span class="font-karla text-[11px] font-medium uppercase tracking-[0.12em] text-secondary">
          {juego}
        </span>
        <span class="font-karla text-xs text-[#6f6f6f]">{minutos} min</span>
      </div>
      <h3 class="mt-3.5 font-poppins text-[19px] font-semibold leading-[1.3] tracking-[-0.01em] text-[#f3f1ef]">
        {titulo}
      </h3>
      <p class="mt-2.5 flex-1 font-karla text-[14.5px] leading-[1.62] text-[#9a9a9a]">
        {descripcion}
      </p>
      <div class="mt-[18px] flex flex-wrap items-center gap-2 border-t border-[#1f1f1f] pt-4 font-karla text-[12.5px] text-[#6f6f6f]">
        <img
          src="/images/vhostlogo.webp"
          alt=""
          width="20"
          height="20"
          loading="lazy"
          class="h-5 w-5 rounded-full bg-[#232323] p-[3px]"
        />
        <span>{autor}</span>
        <span class="text-[#3a3a3a]">·</span>
        <span>{tema}</span>
        <span class="text-[#3a3a3a]">·</span>
        <span>Act. {actualizado}</span>
      </div>
    </a>
  ) : (
    <a
      href={url}
      class="rounded-[14px] border border-[#1f1f1f] bg-[#111111] p-6 transition-colors hover:border-secondary"
    >
      <span class="font-karla text-[11px] uppercase tracking-[0.12em] text-secondary">
        {juego} · {tema}
      </span>
      <h3 class="mt-3 font-poppins text-lg font-semibold leading-[1.3] text-[#f3f1ef]">
        {titulo}
      </h3>
      <p class="mt-2.5 line-clamp-2 font-karla text-sm leading-relaxed text-[#8d8d8d]">
        {descripcion}
      </p>
      <p class="mt-3 font-karla text-xs text-[#6f6f6f]">Act. {actualizado}</p>
    </a>
  )
}
