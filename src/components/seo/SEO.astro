---
// src/components/seo/SEO.astro
// Única fuente de verdad del <head> SEO: title, description, canonical,
// robots, Open Graph y Twitter Card. Se usa desde MainLayout.

export interface Props {
  title: string; // título completo, ya con la marca
  description: string;
  ogImage?: string; // ruta relativa a /public o URL absoluta
  ogImageAlt?: string;
  noindex?: boolean;
  type?: "website" | "article" | "product";
}

const {
  title,
  description,
  ogImage = "/SEO/vhost-preview.png",
  ogImageAlt = "Vhost — hosting de servidores de juegos",
  noindex = false,
  type = "website",
} = Astro.props;

// Canonical absoluto desde la config del sitio; con trailing slash para
// coincidir con las URLs que emite el sitemap (build format "directory").
const path = Astro.url.pathname;
const canonical = new URL(path.endsWith("/") ? path : path + "/", Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:site_name" content="Vhost" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:locale" content="es_ES" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
