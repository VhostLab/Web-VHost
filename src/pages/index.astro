---
// src/pages/index.astro
import MainLayout from "@layouts/MainLayout.astro";
import CaracteristicasInicio from "@components/sections/home/CaracteristicasInicio.astro";
import "@/styles/global.css";
import StatsSection from "@components/sections/home/StatsSection.astro";
import FAQSection from "@components/sections/pages/FAQSection.astro";
import HeroSlider from "@components/sections/home/HeroSlider.astro";
import PriceComparisonSection from "@components/sections/products/PriceComparisonSection.astro";
import PanelCarrusel from "@components/interactive/PanelCarrusel.astro";
import { organizationSchema, webSiteSchema, faqSchema } from "@data/seo";

const stats = [
  { target: 99.9, suffix: "%", label: "Uptime", icon: "fas fa-clock" },
  {
    target: 1000,
    suffix: "+",
    label: "Servidores creados",
    icon: "fas fa-server",
  },
  {
    target: 3,
    suffix: "+",
    label: "Ubicaciones de datacenter",
    icon: "fas fa-globe",
  },
];

const faqs = [
  {
    question: "¿Qué métodos de pago aceptan?",
    answer:
      "En Vhost puedes pagar con tarjeta de crédito, PayPal y Bizum. El pago es mensual y sin permanencia.",
  },
  {
    question: "¿Cuánto tarda en llegar mi servidor?",
    answer:
      "La instalación en Vhost es instantánea: el servidor se crea automáticamente tras el pago y recibes los datos de acceso al panel por correo en unos minutos.",
  },
  {
    question: "¿Por qué debería elegir Vhost?",
    answer:
      "Vhost combina hardware moderno, protección anti-DDoS incluida, soporte 24/7 en español y precios desde 0,75 €/mes, con nodos propios en España.",
  },
  {
    question: "¿Se puede instalar mods o plugins en los servidores?",
    answer:
      "Sí. Todos los servidores de Vhost incluyen acceso FTP y gestor de archivos en el panel para instalar los mods y plugins que quieras (Forge, Fabric, Spigot, Paper...).",
  },
  {
    question: "¿Los servidores funcionan con Minecraft Bedrock?",
    answer:
      "Sí, los servidores de Minecraft de Vhost soportan tanto Java Edition como Bedrock Edition.",
  },
  {
    question: "¿Puedo subir mi propio mundo al servidor?",
    answer:
      "Sí. Puedes subir tu mundo directamente desde la sección Archivos del panel de Vhost, sin necesidad de FTP externo.",
  },
  {
    question: "¿Actualmente estoy con otro hosting, puedo migrarme a Vhost?",
    answer:
      "Sí, Vhost ofrece migración gratuita: nuestro equipo traslada tu servidor desde tu hosting actual sin que pierdas datos ni configuración.",
  },
  {
    question: "¿Qué plan debería elegir?",
    answer:
      "Para Minecraft vanilla con pocos jugadores basta con 2-4 GB de RAM; con mods o más de 10 jugadores conviene 8 GB o más. Compara las gamas Budget, Normal y Premium o pregúntanos en Discord.",
  },
  {
    question: "¿Qué garantía de disponibilidad ofrecen?",
    answer:
      "Vhost garantiza un 99,9 % de uptime con monitorización 24/7 y protección anti-DDoS en todos los planes.",
  },
  {
    question: "¿Realizan copias de seguridad automáticas?",
    answer:
      "Sí, Vhost ofrece backups diarios automáticos opcionales para proteger tus mundos y archivos.",
  },
];
---

<MainLayout
  title="Hosting de Servidores de Juegos en España"
  description="Vhost es un hosting español de servidores de juegos: Minecraft, Rust, ARK, GTA 5, Hytale y TeamSpeak 3 con anti-DDoS, activación instantánea y soporte 24/7."
  schemas={[organizationSchema, webSiteSchema, faqSchema(faqs)]}
>
  <!-- Hero -->
  <HeroSlider />

  <!-- Price Comparison -->
  <PriceComparisonSection />

  <!-- Features Section -->
  <CaracteristicasInicio />

  <!-- Stats Section -->
  <StatsSection stats={stats} />

  <!-- Interactive Cards Section -->
  <PanelCarrusel />

  <!-- Intro answer-first: respuesta directa para buscadores y motores de IA -->
  <section class="bg-[#0b0b0b] text-white py-12 px-6">
    <div class="container mx-auto max-w-4xl text-center">
      <h2 class="text-2xl md:text-3xl font-poppins font-bold mb-4">
        Hosting de servidores de juegos en España
      </h2>
      <p class="text-gray-300 font-poppins leading-relaxed">
        Vhost es un hosting español de servidores de juegos con nodos en
        Logroño y Barcelona, protección anti-DDoS y soporte 24/7. Alojamos
        servidores de Minecraft desde 0,75 €/mes, TeamSpeak 3 desde 0,99 €/mes
        y también Rust, ARK, GTA 5 (FiveM) y Hytale.
      </p>
      <p class="text-gray-400 font-poppins leading-relaxed mt-3">
        Activación instantánea tras el pago, backups automáticos opcionales y
        un 99,9 % de uptime garantizado. Explora la
        <a href="/tienda/tienda" class="text-secondary hover:underline"
          >tienda por juego</a
        >
        o consulta
        <a href="/juegos" class="text-secondary hover:underline"
          >todos los juegos compatibles</a
        >.
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection
    items={faqs}
    inviteLink="https://discord.gg/Ykr85wevrj"
    backgroundClass="bg-[#101010]"
  />
</MainLayout>
