---
import MainLayout from "@layouts/MainLayout.astro";
import "@/styles/global.css";
import { breadcrumbSchema } from "@data/seo";
import Icono from "@components/utilidades/Icono.astro";
import type { NombreIcono } from "@components/utilidades/iconos";

interface Utilidad {
  url: string;
  icono: NombreIcono;
  nombre: string;
  resumen: string;
  conArchivos: boolean;
  pie: string;
}

const UTILIDADES: Utilidad[] = [
  {
    url: "/utilidades/comprobador-mods/",
    icono: "paquete",
    nombre: "Comprobador de mods",
    resumen:
      "Suelta tu carpeta de mods y te decimos si el servidor va a funcionar con ella y qué hay que arreglar.",
    conArchivos: true,
    pie: "Minecraft · una carpeta entera",
  },
  {
    url: "/utilidades/calculadora-ram/",
    icono: "calculadora",
    nombre: "Calculadora de RAM",
    resumen:
      "Cuánta memoria necesita tu servidor según jugadores y tipo, y qué plan le encaja.",
    conArchivos: false,
    pie: "Minecraft · vanilla, plugins y mods",
  },
  {
    url: "/utilidades/registros-dns/",
    icono: "globo",
    nombre: "Generador de registros DNS",
    resumen:
      "Los registros A y SRV exactos para conectar tu dominio propio a la IP del servidor.",
    conArchivos: false,
    pie: "Cualquier juego · con nota de Cloudflare",
  },
];

const GARANTIAS = [
  {
    icono: "escudo" as NombreIcono,
    titulo: "Sin subidas",
    texto:
      "Los archivos se leen con la API de ficheros del navegador. No sale ni una petición de red.",
  },
  {
    icono: "sin-cuenta" as NombreIcono,
    titulo: "Sin cuenta",
    texto: "No pedimos correo ni registro para usar ninguna de las herramientas.",
  },
  {
    icono: "candado" as NombreIcono,
    titulo: "Sin rastrear lo que escribes",
    texto:
      "Los nombres de archivo, las IP y los dominios que introduzcas no salen de tu equipo.",
  },
];
---

<MainLayout
  title="Utilidades gratuitas para servidores de juegos"
  description="Herramientas gratuitas para administrar tu servidor: comprobador de mods, calculadora de RAM y generador de registros DNS. Sin registro y sin subir archivos."
  schemas={[
    breadcrumbSchema([
      { name: "Inicio", path: "/" },
      { name: "Utilidades", path: "/utilidades" },
    ]),
  ]}
>
  <div class="bg-[#0b0b0b] text-[#f3f1ef]">
    <!-- Cabecera -->
    <section class="mx-auto max-w-[1180px] px-6 pt-16 md:px-10 md:pt-20">
      <span
        class="mb-4 inline-block font-karla text-xs uppercase tracking-[0.16em] text-secondary"
      >
        Utilidades gratuitas
      </span>
      <h1
        class="max-w-[17ch] font-poppins text-[34px] font-semibold leading-[1.08] tracking-[-0.025em] md:text-[52px] md:leading-[1.06]"
      >
        Herramientas para administrar tu servidor
      </h1>
      <p
        class="mt-5 max-w-[58ch] font-karla text-base leading-relaxed text-[#9a9a9a] md:text-lg"
      >
        Sin registro y sin coste. Son las mismas comprobaciones que hacemos en
        soporte cuando alguien nos escribe porque su servidor no arranca.
      </p>

      <div
        class="mt-8 flex max-w-[720px] items-start gap-3.5 rounded-xl border border-[#1f1f1f] bg-[#111111] p-5 md:px-6"
      >
        <Icono nombre="candado" tamano={20} class="mt-0.5 shrink-0 text-secondary" />
        <div>
          <p class="font-inter text-[14.5px] font-semibold text-[#f3f1ef]">
            Todo se procesa en tu navegador
          </p>
          <p class="mt-1.5 font-karla text-sm leading-relaxed text-[#9a9a9a]">
            Ningún archivo se sube a nuestros servidores ni a los de nadie: el
            análisis ocurre en tu equipo y lo que introduzcas desaparece al
            cerrar la pestaña.
          </p>
        </div>
      </div>
    </section>

    <!-- Herramientas -->
    <section class="mx-auto max-w-[1180px] px-6 pt-14 md:px-10">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 class="font-poppins text-[22px] font-semibold tracking-[-0.01em]">
          Disponibles ahora
        </h2>
        <span class="font-karla text-[13px] text-[#6f6f6f]">
          {UTILIDADES.length} herramientas
        </span>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          UTILIDADES.map((u) => (
            <a
              href={u.url}
              class="flex flex-col rounded-[14px] border border-[#1f1f1f] bg-[#111111] p-6 transition-colors hover:border-secondary hover:bg-[#161616]"
            >
              <div class="flex items-center justify-between gap-3">
                <span
                  class:list={[
                    "inline-flex h-10 w-10 items-center justify-center rounded-[10px] border",
                    u.conArchivos
                      ? "border-secondary/30 bg-secondary/10 text-secondary"
                      : "border-[#242424] bg-[#161616] text-[#9a9a9a]",
                  ]}
                >
                  <Icono nombre={u.icono} tamano={20} />
                </span>
                <span
                  class:list={[
                    "rounded-full border px-2.5 py-1 font-karla text-[11px] uppercase tracking-[0.1em]",
                    u.conArchivos
                      ? "border-secondary/30 bg-secondary/10 text-secondary"
                      : "border-[#242424] bg-[#161616] text-[#9a9a9a]",
                  ]}
                >
                  {u.conArchivos ? "Con tus archivos" : "Solo datos"}
                </span>
              </div>
              <h3 class="mt-5 font-poppins text-xl font-semibold leading-[1.25] tracking-[-0.01em] text-[#f3f1ef]">
                {u.nombre}
              </h3>
              <p class="mt-2 flex-1 font-karla text-[14.5px] leading-[1.62] text-[#9a9a9a]">
                {u.resumen}
              </p>
              <div class="mt-5 flex items-center justify-between gap-3 border-t border-[#1f1f1f] pt-4 font-karla text-[12.5px] text-[#6f6f6f]">
                <span>{u.pie}</span>
                <span class="font-medium text-secondary">Abrir →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Garantías -->
    <section class="mx-auto max-w-[1180px] px-6 pt-14 md:px-10">
      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {
          GARANTIAS.map((g) => (
            <div class="rounded-xl border border-[#1f1f1f] bg-[#111111] p-5">
              <Icono nombre={g.icono} tamano={20} class="text-secondary" />
              <p class="mt-3 font-inter text-[14.5px] font-semibold text-[#f3f1ef]">
                {g.titulo}
              </p>
              <p class="mt-1.5 font-karla text-[13.5px] leading-relaxed text-[#9a9a9a]">
                {g.texto}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Cierre -->
    <section class="mx-auto max-w-[1180px] px-6 py-16 md:px-10 md:py-20">
      <div
        class="flex flex-wrap items-center justify-between gap-8 rounded-2xl border border-[#242424] bg-gradient-to-br from-[#1a1a1a] to-[#111111] p-8 md:p-11"
      >
        <div class="max-w-[52ch]">
          <h2
            class="font-poppins text-2xl font-semibold leading-[1.15] tracking-[-0.02em] md:text-[30px]"
          >
            ¿Ya sabes lo que necesitas? Móntalo en dos minutos
          </h2>
          <p class="mt-3.5 font-karla text-base leading-relaxed text-[#9a9a9a]">
            Anti-DDoS incluido, backups automáticos y panel para instalar mods
            sin pelearte con archivos. Desde 0,75 €/mes.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/tienda/minecraft/"
            class="rounded-[10px] bg-secondary px-6 py-3.5 font-inter text-[15px] font-semibold text-[#0b0b0b] transition-colors hover:bg-[#ff9a3c]"
          >
            Ver planes
          </a>
          <a
            href="/juegos/"
            class="rounded-[10px] border border-[#2a2a2a] px-6 py-3.5 font-inter text-[15px] font-medium text-[#f3f1ef] transition-colors hover:border-secondary hover:text-secondary"
          >
            Comparar juegos
          </a>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
