---
import MainLayout from "@layouts/MainLayout.astro";
import "@/styles/global.css";
import { breadcrumbSchema } from "@data/seo";
import CabeceraUtilidad from "@components/utilidades/CabeceraUtilidad.astro";
import Icono from "@components/utilidades/Icono.astro";

const PASOS = [
  { n: 1, titulo: "Añade tus archivos" },
  { n: 2, titulo: "Revisa la lista" },
  { n: 3, titulo: "Mira el resultado" },
];

const GUIAS = [
  {
    url: "/blog/paper-spigot-forge-fabric-cual-elegir/",
    tema: "Mods y plugins",
    titulo: "Paper, Spigot, Forge o Fabric: qué software elegir",
  },
  {
    url: "/blog/gestor-archivos-panel-plugins-mods/",
    tema: "Panel",
    titulo: "Subir plugins y mods desde el gestor de archivos",
  },
  {
    url: "/blog/subir-tps-quitar-lag-servidor-minecraft/",
    tema: "Rendimiento",
    titulo: "Cómo subir los TPS y quitar el lag de tu servidor",
  },
];
---

<MainLayout
  title="Comprobador de mods: cliente o servidor"
  description="Sube tus .jar y descubre cuáles funcionan en un servidor de Minecraft y cuáles son solo de cliente. Se analizan en tu navegador: los archivos no se suben a ningún sitio."
  schemas={[
    breadcrumbSchema([
      { name: "Inicio", path: "/" },
      { name: "Utilidades", path: "/utilidades" },
      { name: "Comprobador de mods", path: "/utilidades/comprobador-mods" },
    ]),
  ]}
>
  <div class="bg-[#0b0b0b] text-[#f3f1ef]">
    <div class="mx-auto max-w-[1080px] px-6 pt-12 pb-20 md:px-10 md:pt-14">
      <CabeceraUtilidad
        miga="Comprobador de mods"
        titulo="Comprobador de mods de Minecraft"
        descripcion="Añade hasta 300 archivos .jar —una carpeta de mods entera— y te decimos cuáles funcionan en un servidor, cuáles son solo de cliente y qué incompatibilidades hay entre ellos."
        privacidad="Tus archivos no salen del navegador: se leen en tu equipo y no se suben a ningún servidor."
      />

      <!-- Pasos -->
      <ol class="mt-9 flex flex-col gap-2 sm:flex-row sm:gap-3">
        {
          PASOS.map((p) => (
            <li
              class="paso flex flex-1 items-center gap-3 rounded-xl border px-4 py-3"
              data-indicador={p.n}
              aria-current="false"
            >
              <span class="numero inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border font-inter text-[13px] font-semibold">
                {p.n}
              </span>
              <span class="rotulo font-inter text-[14px] font-medium">
                {p.titulo}
              </span>
            </li>
          ))
        }
      </ol>

      <!-- Paso 1: añadir -->
      <section data-paso="1" class="mt-6">
        <div
          id="zona"
          class="cursor-pointer rounded-[14px] border border-dashed border-[#2a2a2a] bg-[#111111] px-6 py-16 text-center transition-colors hover:border-secondary hover:bg-[#160f06]"
          role="button"
          tabindex="0"
          aria-label="Añadir archivos .jar"
        >
          <Icono nombre="paquete" tamano={30} class="mx-auto text-[#6f6f6f]" />
          <p class="mt-3.5 font-poppins text-xl font-semibold">
            Arrastra aquí tus .jar
          </p>
          <p class="mt-2 font-karla text-[14.5px] text-[#9a9a9a]">
            o <span class="font-medium text-secondary">selecciónalos desde tu equipo</span>
            · hasta 300 archivos
          </p>
          <input id="fichero" type="file" multiple accept=".jar" class="hidden" />
        </div>
        <section id="errores" class="mt-4 hidden"></section>
      </section>

      <!-- Paso 2: revisar -->
      <section data-paso="2" class="mt-6 hidden">
        <div class="overflow-hidden rounded-[14px] border border-[#1f1f1f] bg-[#111111]">
          <div
            class="flex flex-wrap items-center justify-between gap-3 border-b border-[#1f1f1f] px-5 py-4"
          >
            <span class="font-inter text-[14.5px] font-semibold">
              Archivos añadidos <span id="contador" class="font-normal text-[#6f6f6f]"
              ></span>
            </span>
            <div class="flex flex-wrap gap-2.5">
              <button
                type="button"
                id="anadir-mas"
                class="rounded-lg border border-[#242424] px-3.5 py-2 font-inter text-[13.5px] text-[#9a9a9a] transition-colors hover:border-[#3a3a3a] hover:text-[#f3f1ef]"
              >
                Añadir más
              </button>
              <button
                type="button"
                id="vaciar"
                class="rounded-lg border border-[#242424] px-3.5 py-2 font-inter text-[13.5px] text-[#9a9a9a] transition-colors hover:border-[#3a3a3a] hover:text-[#f3f1ef]"
              >
                Vaciar lista
              </button>
            </div>
          </div>
          <div id="filas" class="max-h-[420px] overflow-y-auto"></div>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <p id="limite" class="font-karla text-[13.5px] text-[#9a9a9a]"></p>
          <button
            type="button"
            id="analizar"
            class="rounded-[10px] bg-secondary px-6 py-3 font-inter text-[15px] font-semibold text-[#0b0b0b] transition-colors hover:bg-[#ff9a3c]"
          >
            Analizar
          </button>
        </div>

        <!-- Progreso -->
        <div
          id="progreso"
          class="mt-4 hidden rounded-[14px] border border-[#1f1f1f] bg-[#111111] p-6"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="font-inter text-[14.5px] font-semibold">Analizando…</span>
            <span id="progreso-texto" class="font-karla text-[13px] text-[#6f6f6f]"
            ></span>
          </div>
          <div class="mt-3.5 h-1.5 overflow-hidden rounded-full bg-[#1f1f1f]">
            <div
              id="progreso-barra"
              class="h-full rounded-full bg-secondary transition-[width] duration-200"
              style="width:0%"
            >
            </div>
          </div>
        </div>
      </section>

      <!-- Paso 3: resultado -->
      <section data-paso="3" class="mt-6 hidden">
        <!-- Con cientos de archivos, poder quedarse solo con los que fallan es
             lo que hace usable el resultado: cada recuento filtra la lista. -->
        <div class="grid gap-3 sm:grid-cols-3">
          <button type="button" class="filtro rounded-xl border p-5 text-left" data-filtro="si" aria-pressed="false">
            <span id="n-si" class="block font-poppins text-[30px] font-semibold leading-none text-[#4caf50]">0</span>
            <span class="mt-2 block font-karla text-[13.5px] text-[#9a9a9a]">Sirven en el servidor</span>
          </button>
          <button type="button" class="filtro rounded-xl border p-5 text-left" data-filtro="no" aria-pressed="false">
            <span id="n-no" class="block font-poppins text-[30px] font-semibold leading-none text-[#ef5350]">0</span>
            <span class="mt-2 block font-karla text-[13.5px] text-[#9a9a9a]">No sirven</span>
          </button>
          <button type="button" class="filtro rounded-xl border p-5 text-left" data-filtro="duda" aria-pressed="false">
            <span id="n-duda" class="block font-poppins text-[30px] font-semibold leading-none text-secondary">0</span>
            <span class="mt-2 block font-karla text-[13.5px] text-[#9a9a9a]">Hay que mirarlos</span>
          </button>
        </div>
        <p id="filtro-activo" class="mt-3 hidden font-karla text-[13.5px] text-[#9a9a9a]"></p>

        <div id="tarjetas" class="mt-5 flex flex-col gap-3"></div>

        <div class="mt-6 flex flex-wrap gap-3">
          <button
            type="button"
            id="reiniciar"
            class="rounded-[10px] bg-secondary px-6 py-3 font-inter text-[15px] font-semibold text-[#0b0b0b] transition-colors hover:bg-[#ff9a3c]"
          >
            Comprobar otros archivos
          </button>
          <button
            type="button"
            id="volver-lista"
            class="rounded-[10px] border border-[#2a2a2a] px-6 py-3 font-inter text-[15px] font-medium text-[#f3f1ef] transition-colors hover:border-secondary hover:text-secondary"
          >
            Volver a la lista
          </button>
        </div>
      </section>

      <!-- Guías -->
      <section class="mt-14 border-t border-[#1f1f1f] pt-9">
        <h2 class="font-poppins text-xl font-semibold">Guías relacionadas</h2>
        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {
            GUIAS.map((g) => (
              <a
                href={g.url}
                class="rounded-xl border border-[#1f1f1f] bg-[#111111] p-5 transition-colors hover:border-secondary"
              >
                <span class="font-karla text-[11px] uppercase tracking-[0.12em] text-secondary">
                  {g.tema}
                </span>
                <h3 class="mt-2.5 font-poppins text-[16.5px] font-semibold leading-[1.3] text-[#f3f1ef]">
                  {g.titulo}
                </h3>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<style>
  /* Estado de cada paso del asistente. */
  .paso {
    border-color: #1f1f1f;
    background: #0f0f0f;
    color: #6f6f6f;
  }
  .paso .numero {
    border-color: #2a2a2a;
    color: #6f6f6f;
  }
  /* Paso en curso. */
  .paso[aria-current="step"] {
    border-color: rgba(252, 124, 4, 0.4);
    background: rgba(252, 124, 4, 0.07);
    color: #f3f1ef;
  }
  .paso[aria-current="step"] .numero {
    border-color: #fc7c04;
    background: #fc7c04;
    color: #0b0b0b;
  }
  .filtro {
    border-color: #1f1f1f;
    background: #111111;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .filtro:hover {
    border-color: #3a3a3a;
  }
  .filtro[aria-pressed="true"] {
    border-color: #fc7c04;
    background: rgba(252, 124, 4, 0.06);
  }

  /* Pasos ya superados: se puede volver a ellos. */
  .paso[data-hecho="si"] {
    color: #c9c7c4;
    cursor: pointer;
  }
  .paso[data-hecho="si"]:hover {
    border-color: #3a3a3a;
  }
  .paso[data-hecho="si"] .numero {
    border-color: rgba(252, 124, 4, 0.5);
    color: #fc7c04;
  }
</style>

<script>
  import { analizarJar, sirveEnServidor, type Analisis } from "@utils/jar";

  // Un modpack grande ronda los 200-400 mods, así que el tope tiene que dar
  // para una carpeta entera. Cada archivo cuesta unos KB de lectura, no el
  // fichero completo, así que subirlo no encarece el análisis.
  const MAXIMO = 300;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  const zona = $("zona");
  const entrada = $("fichero") as HTMLInputElement;
  let archivos: File[] = [];
  let analisis: Analisis[] = [];
  let paso = 1;
  let filtro: "si" | "no" | "duda" | null = null;

  const escapar = (t: string) =>
    t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const peso = (b: number) =>
    b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.round(b / 1024)} KB`;

  const ETIQUETA_LADO: Record<string, string> = {
    cliente: "Solo cliente",
    servidor: "Solo servidor",
    ambos: "Cliente y servidor",
    proxy: "Proxy",
    "sin-declarar": "No lo declara",
  };

  // --- navegación entre pasos ---------------------------------------------

  function irA(n: number) {
    paso = n;
    for (const seccion of document.querySelectorAll<HTMLElement>("[data-paso]")) {
      seccion.classList.toggle("hidden", Number(seccion.dataset.paso) !== n);
    }
    for (const ind of document.querySelectorAll<HTMLElement>("[data-indicador]")) {
      const suyo = Number(ind.dataset.indicador);
      ind.setAttribute("aria-current", suyo === n ? "step" : "false");
      // Un paso ya superado se puede volver a abrir; uno futuro, no.
      const alcanzable =
        suyo < n && (suyo === 1 || (suyo === 2 && archivos.length > 0));
      ind.dataset.hecho = alcanzable ? "si" : "no";
    }
    document.querySelector("[data-paso]")?.scrollIntoView({ block: "nearest" });
  }

  for (const ind of document.querySelectorAll<HTMLElement>("[data-indicador]")) {
    ind.addEventListener("click", () => {
      if (ind.dataset.hecho === "si") irA(Number(ind.dataset.indicador));
    });
  }

  // --- añadir y quitar archivos -------------------------------------------

  function anadir(nuevos: FileList | null) {
    if (!nuevos) return;
    const entrantes = Array.from(nuevos);
    const noJar = entrantes.filter((f) => !/\.jar$/i.test(f.name));
    const jars = entrantes.filter((f) => /\.jar$/i.test(f.name));

    const hueco = MAXIMO - archivos.length;
    archivos = archivos.concat(jars.slice(0, Math.max(hueco, 0)));
    analisis = [];

    const problemas: string[] = [];
    if (noJar.length) {
      problemas.push(
        `${noJar.length === 1 ? "Un archivo no es" : `${noJar.length} archivos no son`} .jar y se ${noJar.length === 1 ? "ha" : "han"} descartado.`
      );
    }
    if (jars.length > hueco && hueco >= 0) {
      problemas.push(`Solo caben ${MAXIMO} archivos: los de más se han dejado fuera.`);
    }
    mostrarErrores(problemas);
    pintarLista();
    if (archivos.length) irA(2);
  }

  function mostrarErrores(mensajes: string[]) {
    const caja = $("errores");
    caja.classList.toggle("hidden", mensajes.length === 0);
    caja.innerHTML = mensajes.length
      ? `<div class="flex items-start gap-3 rounded-xl border border-[#402020] bg-[#170f0f] px-5 py-4">
           <span class="mt-0.5 shrink-0 text-[#ef5350]">✕</span>
           <p class="font-karla text-sm leading-relaxed text-[#c9c7c4]">${mensajes.map(escapar).join(" ")}</p>
         </div>`
      : "";
  }

  // --- comprobaciones del conjunto ----------------------------------------

  // Lo que aporta el propio servidor: no tiene sentido pedir que esté en la
  // lista de archivos del usuario.
  const PLATAFORMA = new Set([
    "minecraft",
    "java",
    "fabricloader",
    "fabric-loader",
    "forge",
    "neoforge",
    "quilt_loader",
    "quilt_base",
    "mixinextras",
  ]);

  /**
   * Problemas de cada archivo respecto a los demás de la lista.
   *
   * Van pegados al archivo que los tiene, no en un bloque aparte: si a un mod
   * le falta una dependencia, lo útil es verlo en su propia ficha y no tener
   * que cruzar una lista de avisos con la de archivos.
   */
  function problemasPorArchivo(res: Analisis[]): string[][] {
    const validos = res.filter((r) => !r.error);
    const provistos = new Set(validos.map((r) => r.id).filter(Boolean));
    const conFabricApi = provistos.has("fabric-api") || provistos.has("fabric");

    const cargadoresMod = [
      ...new Set(
        validos
          .map((r) => r.cargador)
          .filter((c) => ["Fabric", "Forge", "NeoForge", "Quilt"].includes(c))
      ),
    ];
    const versiones = [
      ...new Set(
        validos
          .filter((r) => ["Fabric", "Forge", "NeoForge", "Quilt"].includes(r.cargador))
          .map((r) => r.minecraft)
          .filter(Boolean)
      ),
    ];
    const hayPlugin = validos.some((r) => r.cargador === "Bukkit");
    const hayMod = cargadoresMod.length > 0;

    return res.map((r) => {
      if (r.error) return [];
      const problemas: string[] = [];
      const esMod = ["Fabric", "Forge", "NeoForge", "Quilt"].includes(r.cargador);

      // Dependencias que este archivo pide y no están en la lista.
      const faltan = r.dependencias.filter((dep) => {
        if (!dep || PLATAFORMA.has(dep) || provistos.has(dep)) return false;
        if (conFabricApi && dep.startsWith("fabric")) return false;
        return true;
      });
      if (faltan.length) {
        const soloFabric = faltan.every((d) => d.startsWith("fabric"));
        problemas.push(
          soloFabric && !conFabricApi
            ? "Necesita Fabric API y no está en la lista: añádela en la misma versión de Minecraft."
            : `Necesita ${faltan.slice(0, 4).join(", ")}${faltan.length > 4 ? " y alguna más" : ""}, que no ${faltan.length === 1 ? "está" : "están"} en la lista.`
        );
      }

      // Choques con el resto de archivos.
      if (esMod && cargadoresMod.length > 1) {
        const otros = cargadoresMod.filter((c) => c !== r.cargador);
        problemas.push(
          `Es de ${r.cargador} y en la lista hay mods de ${otros.join(" y ")}. Un servidor solo carga un cargador.`
        );
      }
      if (esMod && r.minecraft && versiones.length > 1) {
        const otras = versiones.filter((v) => v !== r.minecraft);
        problemas.push(
          `Es para Minecraft ${r.minecraft} y en la lista hay mods para ${otras.join(" y ")}.`
        );
      }
      if (hayPlugin && hayMod) {
        if (r.cargador === "Bukkit") {
          problemas.push("Es un plugin y en la lista hay mods: un servidor normal no carga las dos cosas.");
        } else if (esMod) {
          problemas.push("Es un mod y en la lista hay plugins: un servidor normal no carga las dos cosas.");
        }
      }
      if (r.cargador === "Proxy" && (hayPlugin || hayMod)) {
        problemas.push("Va en el proxy (BungeeCord o Velocity), no en el servidor de juego.");
      }

      return problemas;
    });
  }

  // --- pintado -------------------------------------------------------------

  function pintarLista() {
    $("contador").textContent = `${archivos.length}/${MAXIMO}`;
    const anadirMas = $("anadir-mas") as HTMLButtonElement;
    anadirMas.disabled = archivos.length >= MAXIMO;
    anadirMas.classList.toggle("opacity-40", archivos.length >= MAXIMO);
    $("limite").textContent =
      archivos.length >= MAXIMO
        ? `Has llegado al máximo de ${MAXIMO} archivos. Analiza estos y repite con el resto.`
        : "";

    $("filas").innerHTML = archivos
      .map(
        (f, i) => `
        <div class="flex items-center justify-between gap-4 border-b border-[#161616] px-5 py-3">
          <div class="flex min-w-0 items-center gap-3">
            <span class="shrink-0 text-[#6f6f6f]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5L13.5 3Z"/><path d="M13.5 3v5.5H19"/></svg>
            </span>
            <span class="truncate font-inter text-sm">${escapar(f.name)}</span>
            <span class="shrink-0 font-karla text-[12.5px] text-[#6f6f6f]">${peso(f.size)}</span>
          </div>
          <button type="button" data-quitar="${i}" aria-label="Quitar ${escapar(f.name)}" class="shrink-0 rounded p-1.5 text-[#6f6f6f] transition-colors hover:text-[#ef5350]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6.5 6.5l11 11"/><path d="M17.5 6.5l-11 11"/></svg>
          </button>
        </div>`
      )
      .join("");

    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-quitar]")) {
      b.addEventListener("click", () => {
        archivos = archivos.filter((_, j) => j !== Number(b.dataset.quitar));
        analisis = [];
        pintarLista();
        if (!archivos.length) irA(1);
      });
    }
  }

  function pintarResultados() {
    const res = analisis;
    if (!res.length) return;

    const veredictos = res.map((r) => (r.error ? "duda" : sirveEnServidor(r)));
    $("n-si").textContent = String(veredictos.filter((v) => v === "si").length);
    $("n-no").textContent = String(veredictos.filter((v) => v === "no").length);
    $("n-duda").textContent = String(veredictos.filter((v) => v === "duda").length);

    const problemas = problemasPorArchivo(res);

    // Los que fallan primero. Con una carpeta de 300 mods, el que necesita
    // atención no puede quedar sepultado entre los que están bien.
    const ORDEN = { no: 0, duda: 1, si: 2 } as const;
    const ordenados = res
      .map((r, i) => ({ r, problemas: problemas[i] ?? [], v: r.error ? "duda" : sirveEnServidor(r) }))
      .sort(
        (a, b) =>
          ORDEN[a.v as keyof typeof ORDEN] - ORDEN[b.v as keyof typeof ORDEN] ||
          b.problemas.length - a.problemas.length ||
          a.r.archivo.localeCompare(b.r.archivo, "es")
      );

    const visibles = filtro ? ordenados.filter((x) => x.v === filtro) : ordenados;

    for (const b of document.querySelectorAll<HTMLElement>("[data-filtro]")) {
      b.setAttribute("aria-pressed", String(b.dataset.filtro === filtro));
    }
    const rotulo = $("filtro-activo");
    rotulo.classList.toggle("hidden", !filtro);
    rotulo.textContent = filtro
      ? `Mostrando ${visibles.length} de ${res.length} archivos. Vuelve a pulsar el recuento para verlos todos.`
      : "";

    $("tarjetas").innerHTML = visibles
      .map(({ r, problemas: suyos }) => {
        const v = r.error ? "duda" : sirveEnServidor(r);
        const insignia =
          v === "si"
            ? `<span class="shrink-0 rounded-full border border-[#4caf50]/30 bg-[#4caf50]/10 px-3 py-1.5 font-inter text-[12.5px] font-semibold text-[#4caf50]">Sirve</span>`
            : v === "no"
              ? `<span class="shrink-0 rounded-full border border-[#ef5350]/30 bg-[#ef5350]/10 px-3 py-1.5 font-inter text-[12.5px] font-semibold text-[#ef5350]">No sirve</span>`
              : `<span class="shrink-0 rounded-full border border-secondary/30 bg-secondary/10 px-3 py-1.5 font-inter text-[12.5px] font-semibold text-secondary">Míralo</span>`;

        const celda = (etiqueta: string, valor: string) => `
          <div>
            <p class="font-karla text-[11px] uppercase tracking-[0.1em] text-[#6f6f6f]">${etiqueta}</p>
            <p class="mt-0.5 font-karla text-[13.5px] text-[#c9c7c4]">${escapar(valor || "—")}</p>
          </div>`;

        const cuerpo = r.error
          ? `<p class="mt-3 font-karla text-sm leading-relaxed text-[#ef5350]">${escapar(r.error)}</p>`
          : `<div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
               ${celda("Tipo", r.tipo)}
               ${celda("Lado", ETIQUETA_LADO[r.lado] ?? r.lado)}
               ${celda("Minecraft", r.minecraft)}
               ${celda("Cargador", r.cargador === "?" ? "" : r.cargador)}
             </div>
             ${
               suyos.length
                 ? `<ul class="mt-4 flex flex-col gap-2 border-t border-[#1f1f1f] pt-3.5">
                      ${suyos
                        .map(
                          (m) => `<li class="flex gap-2.5 font-karla text-[13.5px] leading-relaxed text-secondary">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><path d="M12 4.2 21 19.2H3L12 4.2Z"/><path d="M12 10v4"/><path d="M12 16.8h.01"/></svg>
                            <span>${escapar(m)}</span>
                          </li>`
                        )
                        .join("")}
                    </ul>`
                 : ""
             }`;

        return `
          <div class="rounded-[14px] border border-[#1f1f1f] bg-[#111111] p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="truncate font-inter text-[15px] font-semibold text-[#f3f1ef]">${escapar(r.archivo)}</p>
                ${r.nombreMod && r.nombreMod !== r.archivo ? `<p class="mt-0.5 truncate font-karla text-[13px] text-[#6f6f6f]">${escapar(r.nombreMod)}</p>` : ""}
              </div>
              ${insignia}
            </div>
            ${cuerpo}
          </div>`;
      })
      .join("");
  }

  // --- análisis ------------------------------------------------------------

  async function analizar() {
    if (!archivos.length) return;
    analisis = [];
    filtro = null;
    $("progreso").classList.remove("hidden");
    ($("analizar") as HTMLButtonElement).disabled = true;

    for (let i = 0; i < archivos.length; i++) {
      $("progreso-texto").textContent = `${i + 1} de ${archivos.length}`;
      $("progreso-barra").style.width = `${Math.round((i / archivos.length) * 100)}%`;
      // Deja respirar al navegador para que la barra se vea avanzar.
      await new Promise((r) => setTimeout(r, 0));
      analisis.push(await analizarJar(archivos[i]));
    }

    $("progreso-barra").style.width = "100%";
    $("progreso").classList.add("hidden");
    ($("analizar") as HTMLButtonElement).disabled = false;
    pintarResultados();
    irA(3);
  }

  // --- eventos -------------------------------------------------------------

  const elegir = () => entrada.click();
  zona.addEventListener("click", elegir);
  zona.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      elegir();
    }
  });
  $("anadir-mas").addEventListener("click", elegir);
  entrada.addEventListener("change", () => {
    anadir(entrada.files);
    entrada.value = "";
  });

  for (const evento of ["dragenter", "dragover"] as const) {
    zona.addEventListener(evento, (e) => {
      e.preventDefault();
      zona.classList.add("border-secondary", "bg-[#160f06]");
    });
  }
  for (const evento of ["dragleave", "drop"] as const) {
    zona.addEventListener(evento, () => zona.classList.remove("border-secondary", "bg-[#160f06]"));
  }
  zona.addEventListener("drop", (e) => {
    e.preventDefault();
    anadir(e.dataTransfer?.files ?? null);
  });

  $("vaciar").addEventListener("click", () => {
    archivos = [];
    analisis = [];
    mostrarErrores([]);
    pintarLista();
    irA(1);
  });
  for (const b of document.querySelectorAll<HTMLElement>("[data-filtro]")) {
    b.addEventListener("click", () => {
      const suyo = b.dataset.filtro as "si" | "no" | "duda";
      filtro = filtro === suyo ? null : suyo;
      pintarResultados();
    });
  }

  $("analizar").addEventListener("click", analizar);
  $("volver-lista").addEventListener("click", () => irA(2));
  $("reiniciar").addEventListener("click", () => {
    archivos = [];
    analisis = [];
    mostrarErrores([]);
    pintarLista();
    irA(1);
  });

  pintarLista();
  irA(1);
</script>
