---
import MainLayout from "@layouts/MainLayout.astro";
import "@/styles/global.css";
import { breadcrumbSchema } from "@data/seo";
import CabeceraUtilidad from "@components/utilidades/CabeceraUtilidad.astro";
import Icono from "@components/utilidades/Icono.astro";

const GUIAS = [
  {
    url: "/blog/paper-spigot-forge-fabric-cual-elegir/",
    tema: "Mods y plugins",
    titulo: "Paper, Spigot, Forge o Fabric: qué software elegir",
  },
  {
    url: "/blog/gestor-archivos-panel-plugins-mods/",
    tema: "Panel",
    titulo: "Subir plugins y mods desde el gestor de archivos",
  },
  {
    url: "/blog/subir-tps-quitar-lag-servidor-minecraft/",
    tema: "Rendimiento",
    titulo: "Cómo subir los TPS y quitar el lag de tu servidor",
  },
];
---

<MainLayout
  title="Comprobador de mods: cliente o servidor"
  description="Sube tus .jar y descubre cuáles funcionan en un servidor de Minecraft y cuáles son solo de cliente. Se analizan en tu navegador: los archivos no se suben a ningún sitio."
  schemas={[
    breadcrumbSchema([
      { name: "Inicio", path: "/" },
      { name: "Utilidades", path: "/utilidades" },
      { name: "Comprobador de mods", path: "/utilidades/comprobador-mods" },
    ]),
  ]}
>
  <div class="bg-[#0b0b0b] text-[#f3f1ef]">
    <div class="mx-auto max-w-[1080px] px-6 pt-12 pb-20 md:px-10 md:pt-14">
      <CabeceraUtilidad
        miga="Comprobador de mods"
        titulo="Comprobador de mods de Minecraft"
        descripcion="Añade hasta 10 archivos .jar y te decimos cuáles funcionan en un servidor, cuáles son solo de cliente y qué incompatibilidades hay entre ellos."
        privacidad="Tus archivos no salen del navegador: se leen en tu equipo y no se suben a ningún servidor."
      />

      <!-- Zona de carga -->
      <section class="mt-8">
        <div
          id="zona"
          class="cursor-pointer rounded-[14px] border border-dashed border-[#2a2a2a] bg-[#111111] px-6 py-12 text-center transition-colors hover:border-secondary hover:bg-[#160f06]"
          role="button"
          tabindex="0"
          aria-label="Añadir archivos .jar"
        >
          <Icono nombre="paquete" tamano={28} class="mx-auto text-[#6f6f6f]" />
          <p class="mt-3 font-poppins text-[19px] font-semibold">
            Arrastra aquí tus .jar
          </p>
          <p class="mt-2 font-karla text-[14.5px] text-[#9a9a9a]">
            o <span class="font-medium text-secondary">selecciónalos desde tu equipo</span>
            · máximo 10 archivos
          </p>
          <input id="fichero" type="file" multiple accept=".jar" class="hidden" />
        </div>
        <p
          id="limite"
          class="mt-3 hidden rounded-xl border border-secondary/30 bg-secondary/[0.06] px-5 py-4 font-karla text-sm text-[#c9c7c4]"
        >
        </p>
      </section>

      <!-- Errores de lectura -->
      <section id="errores" class="mt-4 hidden"></section>

      <!-- Lista de archivos -->
      <section
        id="lista"
        class="mt-5 hidden overflow-hidden rounded-[14px] border border-[#1f1f1f] bg-[#111111]"
      >
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-b border-[#1f1f1f] px-5 py-4"
        >
          <span class="font-inter text-[14.5px] font-semibold">
            Archivos añadidos <span id="contador" class="font-normal text-[#6f6f6f]"
            ></span>
          </span>
          <div class="flex gap-2.5">
            <button
              type="button"
              id="vaciar"
              class="rounded-lg border border-[#242424] px-3.5 py-2 font-inter text-[13.5px] text-[#9a9a9a] transition-colors hover:border-[#3a3a3a] hover:text-[#f3f1ef]"
            >
              Vaciar lista
            </button>
            <button
              type="button"
              id="analizar"
              class="rounded-lg bg-secondary px-4 py-2 font-inter text-[13.5px] font-semibold text-[#0b0b0b] transition-colors hover:bg-[#ff9a3c]"
            >
              Analizar
            </button>
          </div>
        </div>
        <div id="filas"></div>
      </section>

      <!-- Progreso -->
      <section
        id="progreso"
        class="mt-5 hidden rounded-[14px] border border-[#1f1f1f] bg-[#111111] p-6"
      >
        <div class="flex items-center justify-between gap-4">
          <span class="font-inter text-[14.5px] font-semibold">Analizando…</span>
          <span id="progreso-texto" class="font-karla text-[13px] text-[#6f6f6f]"
          ></span>
        </div>
        <div class="mt-3.5 h-1.5 overflow-hidden rounded-full bg-[#1f1f1f]">
          <div
            id="progreso-barra"
            class="h-full rounded-full bg-secondary transition-[width] duration-200"
            style="width:0%"
          >
          </div>
        </div>
      </section>

      <!-- Resultados -->
      <section id="resultados" class="mt-8 hidden">
        <div class="grid gap-3 sm:grid-cols-3">
          <div
            class="rounded-xl border border-[#1f1f1f] bg-[#111111] p-5 border-l-2 border-l-[#4caf50]"
          >
            <p
              id="n-si"
              class="font-poppins text-[30px] font-semibold leading-none text-[#4caf50]"
            >
              0
            </p>
            <p class="mt-2 font-karla text-[13.5px] text-[#9a9a9a]">
              Sirven en el servidor
            </p>
          </div>
          <div
            class="rounded-xl border border-[#1f1f1f] bg-[#111111] p-5 border-l-2 border-l-[#ef5350]"
          >
            <p
              id="n-no"
              class="font-poppins text-[30px] font-semibold leading-none text-[#ef5350]"
            >
              0
            </p>
            <p class="mt-2 font-karla text-[13.5px] text-[#9a9a9a]">No sirven</p>
          </div>
          <div
            class="rounded-xl border border-[#1f1f1f] bg-[#111111] p-5 border-l-2 border-l-secondary"
          >
            <p
              id="n-duda"
              class="font-poppins text-[30px] font-semibold leading-none text-secondary"
            >
              0
            </p>
            <p class="mt-2 font-karla text-[13.5px] text-[#9a9a9a]">
              Hay que mirarlos
            </p>
          </div>
        </div>

        <div
          id="avisos"
          class="mt-4 hidden rounded-[14px] border border-secondary/30 bg-secondary/[0.06] p-6"
        >
          <p class="font-inter text-[14.5px] font-semibold text-secondary">
            Avisos del conjunto
          </p>
          <p class="mt-1 font-karla text-[13.5px] text-[#9a9a9a]">
            Problemas que aparecen al juntar estos archivos, aunque cada uno sea
            válido por separado.
          </p>
          <div id="avisos-lista" class="mt-4 flex flex-col gap-3"></div>
        </div>

        <div id="tarjetas" class="mt-5 flex flex-col gap-3"></div>
      </section>

      <!-- Guías -->
      <section class="mt-14 border-t border-[#1f1f1f] pt-9">
        <h2 class="font-poppins text-xl font-semibold">Guías relacionadas</h2>
        <div class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
          {
            GUIAS.map((g) => (
              <a
                href={g.url}
                class="rounded-xl border border-[#1f1f1f] bg-[#111111] p-5 transition-colors hover:border-secondary"
              >
                <span class="font-karla text-[11px] uppercase tracking-[0.12em] text-secondary">
                  {g.tema}
                </span>
                <h3 class="mt-2.5 font-poppins text-[16.5px] font-semibold leading-[1.3] text-[#f3f1ef]">
                  {g.titulo}
                </h3>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<script>
  import { analizarJar, sirveEnServidor, type Analisis } from "@utils/jar";

  const MAXIMO = 10;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  const zona = $("zona");
  const entrada = $("fichero") as HTMLInputElement;
  let archivos: File[] = [];
  let analisis: Analisis[] = [];
  const abiertos = new Set<string>();

  const escapar = (t: string) =>
    t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const peso = (b: number) =>
    b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.round(b / 1024)} KB`;

  const ETIQUETA_LADO: Record<string, string> = {
    cliente: "Solo cliente",
    servidor: "Solo servidor",
    ambos: "Cliente y servidor",
    proxy: "Proxy",
    "sin-declarar": "No lo declara",
  };

  // --- añadir y quitar archivos -------------------------------------------

  function anadir(nuevos: FileList | null) {
    if (!nuevos) return;
    const entrantes = Array.from(nuevos);
    const noJar = entrantes.filter((f) => !/\.jar$/i.test(f.name));
    const jars = entrantes.filter((f) => /\.jar$/i.test(f.name));

    const hueco = MAXIMO - archivos.length;
    archivos = archivos.concat(jars.slice(0, Math.max(hueco, 0)));
    analisis = [];

    const problemas: string[] = [];
    if (noJar.length) {
      problemas.push(
        `${noJar.length === 1 ? "Un archivo no es" : `${noJar.length} archivos no son`} .jar y se ${noJar.length === 1 ? "ha" : "han"} descartado.`
      );
    }
    if (jars.length > hueco && hueco >= 0) {
      problemas.push(`Solo caben ${MAXIMO} archivos: los de más se han dejado fuera.`);
    }
    mostrarErrores(problemas);
    pintar();
  }

  function mostrarErrores(mensajes: string[]) {
    const caja = $("errores");
    caja.classList.toggle("hidden", mensajes.length === 0);
    caja.innerHTML = mensajes.length
      ? `<div class="flex items-start gap-3 rounded-xl border border-[#402020] bg-[#170f0f] px-5 py-4">
           <span class="mt-0.5 shrink-0 text-[#ef5350]">✕</span>
           <p class="font-karla text-sm leading-relaxed text-[#c9c7c4]">${mensajes.map(escapar).join(" ")}</p>
         </div>`
      : "";
  }

  // --- comprobaciones del conjunto ----------------------------------------

  // Lo que aporta el propio servidor: no tiene sentido pedir que esté en la
  // lista de archivos del usuario.
  const PLATAFORMA = new Set([
    "minecraft",
    "java",
    "fabricloader",
    "fabric-loader",
    "forge",
    "neoforge",
    "quilt_loader",
    "quilt_base",
    "mixinextras",
  ]);

  function avisosDelConjunto(res: Analisis[]) {
    const avisos: { etiqueta: string; titulo: string; detalle: string }[] = [];
    const validos = res.filter((r) => !r.error);

    const cargadores = [
      ...new Set(
        validos.map((r) => r.cargador).filter((c) => ["Fabric", "Forge", "NeoForge", "Quilt"].includes(c))
      ),
    ];
    if (cargadores.length > 1) {
      avisos.push({
        etiqueta: "Cargadores",
        titulo: "Mezcla de cargadores incompatibles",
        detalle: `Hay archivos de ${cargadores.join(" y ")} en la misma lista. Un servidor solo puede ejecutar uno: elige cargador y deja fuera el resto.`,
      });
    }

    // Solo se comparan mods entre sí. El api-version de un plugin es un
    // mínimo ("de 1.13 en adelante"), no la versión del servidor, así que
    // cruzarlo con la de un mod daría un aviso falso.
    const versiones = [
      ...new Set(
        validos
          .filter((r) => ["Fabric", "Forge", "NeoForge", "Quilt"].includes(r.cargador))
          .map((r) => r.minecraft)
          .filter(Boolean)
      ),
    ];
    if (versiones.length > 1) {
      avisos.push({
        etiqueta: "Versiones",
        titulo: "Versiones de Minecraft que no casan",
        detalle: `Conviven mods para ${versiones.join(" y ")}. Todos tienen que coincidir con la versión del servidor o el arranque fallará.`,
      });
    }

    // Dependencias: Fabric API se reparte en módulos (fabric-rendering-v1,
    // fabric-resource-loader-v0...), así que si está el jar principal, todos
    // los que empiezan por "fabric-" quedan cubiertos.
    const provistos = new Set(validos.map((r) => r.id).filter(Boolean));
    const conFabricApi = provistos.has("fabric-api") || provistos.has("fabric");
    const faltan = new Set<string>();
    for (const r of validos) {
      for (const dep of r.dependencias) {
        if (!dep || PLATAFORMA.has(dep) || provistos.has(dep)) continue;
        if (conFabricApi && dep.startsWith("fabric")) continue;
        faltan.add(dep);
      }
    }
    if (faltan.size) {
      const lista = [...faltan];
      const deFabric = lista.filter((d) => d.startsWith("fabric"));
      const otras = lista.filter((d) => !d.startsWith("fabric"));

      if (deFabric.length && !conFabricApi) {
        avisos.push({
          etiqueta: "Dependencias",
          titulo: "Falta Fabric API",
          detalle: `Hay mods que necesitan módulos de Fabric API (${deFabric.slice(0, 3).join(", ")}${deFabric.length > 3 ? "…" : ""}) y no está en la lista. Se instala como un .jar más, en la misma versión de Minecraft que el resto.`,
        });
      }
      if (otras.length) {
        avisos.push({
          etiqueta: "Dependencias",
          titulo: otras.length === 1 ? "Falta una dependencia" : "Faltan dependencias",
          detalle: `Estos archivos piden ${otras.slice(0, 6).join(", ")}${otras.length > 6 ? " y alguna más" : ""}, y no ${otras.length === 1 ? "está" : "están"} en la lista. Sin ${otras.length === 1 ? "ella" : "ellas"} el servidor no arrancará.`,
        });
      }
    }

    const hayPlugin = validos.some((r) => r.cargador === "Bukkit");
    const hayMod = validos.some((r) => ["Fabric", "Forge", "NeoForge", "Quilt"].includes(r.cargador));
    if (hayPlugin && hayMod) {
      avisos.push({
        etiqueta: "Plugins y mods",
        titulo: "Plugins y mods mezclados",
        detalle:
          "Paper no carga mods y Fabric o Forge no cargan plugins. Necesitas un servidor híbrido, o separar los archivos en dos servidores.",
      });
    }

    const hayProxy = validos.some((r) => r.cargador === "Proxy");
    if (hayProxy && (hayPlugin || hayMod)) {
      avisos.push({
        etiqueta: "Proxy",
        titulo: "Hay plugins de proxy en la lista",
        detalle:
          "Los plugins de proxy van en BungeeCord o Velocity, que es una pieza aparte delante de los servidores. En el servidor de juego no hacen nada.",
      });
    }

    return avisos;
  }

  // --- pintado -------------------------------------------------------------

  function pintar() {
    $("lista").classList.toggle("hidden", archivos.length === 0);
    $("contador").textContent = `${archivos.length}/${MAXIMO}`;
    zona.classList.toggle("hidden", archivos.length >= MAXIMO);

    const limite = $("limite");
    limite.classList.toggle("hidden", archivos.length < MAXIMO);
    limite.textContent =
      archivos.length >= MAXIMO
        ? `Has llegado al máximo de ${MAXIMO} archivos. Quita alguno para añadir otro, o analiza estos y repite con el resto.`
        : "";

    $("filas").innerHTML = archivos
      .map(
        (f, i) => `
        <div class="flex items-center justify-between gap-4 border-b border-[#161616] px-5 py-3">
          <div class="flex min-w-0 items-center gap-3">
            <span class="shrink-0 text-[#6f6f6f]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5L13.5 3Z"/><path d="M13.5 3v5.5H19"/></svg>
            </span>
            <span class="truncate font-inter text-sm">${escapar(f.name)}</span>
            <span class="shrink-0 font-karla text-[12.5px] text-[#6f6f6f]">${peso(f.size)}</span>
          </div>
          <button type="button" data-quitar="${i}" aria-label="Quitar ${escapar(f.name)}" class="shrink-0 rounded p-1.5 text-[#6f6f6f] transition-colors hover:text-[#ef5350]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6.5 6.5l11 11"/><path d="M17.5 6.5l-11 11"/></svg>
          </button>
        </div>`
      )
      .join("");

    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-quitar]")) {
      b.addEventListener("click", () => {
        archivos = archivos.filter((_, j) => j !== Number(b.dataset.quitar));
        analisis = [];
        $("resultados").classList.add("hidden");
        pintar();
      });
    }
  }

  function pintarResultados() {
    const res = analisis;
    $("resultados").classList.toggle("hidden", res.length === 0);
    if (!res.length) return;

    const veredictos = res.map((r) => (r.error ? "duda" : sirveEnServidor(r)));
    $("n-si").textContent = String(veredictos.filter((v) => v === "si").length);
    $("n-no").textContent = String(veredictos.filter((v) => v === "no").length);
    $("n-duda").textContent = String(veredictos.filter((v) => v === "duda").length);

    const avisos = avisosDelConjunto(res);
    $("avisos").classList.toggle("hidden", avisos.length === 0);
    $("avisos-lista").innerHTML = avisos
      .map(
        (a) => `
        <div class="flex flex-col gap-1 border-t border-secondary/20 pt-3 sm:flex-row sm:gap-4">
          <span class="shrink-0 font-karla text-[11px] uppercase tracking-[0.1em] text-secondary sm:w-32 sm:pt-0.5">${escapar(a.etiqueta)}</span>
          <div>
            <p class="font-inter text-[14.5px] font-medium text-[#f3f1ef]">${escapar(a.titulo)}</p>
            <p class="mt-1 font-karla text-sm leading-relaxed text-[#9a9a9a]">${escapar(a.detalle)}</p>
          </div>
        </div>`
      )
      .join("");

    $("tarjetas").innerHTML = res
      .map((r, i) => {
        const v = r.error ? "duda" : sirveEnServidor(r);
        const insignia =
          v === "si"
            ? `<span class="shrink-0 rounded-full border border-[#4caf50]/30 bg-[#4caf50]/10 px-3 py-1.5 font-inter text-[12.5px] font-semibold text-[#4caf50]">Sirve</span>`
            : v === "no"
              ? `<span class="shrink-0 rounded-full border border-[#ef5350]/30 bg-[#ef5350]/10 px-3 py-1.5 font-inter text-[12.5px] font-semibold text-[#ef5350]">No sirve</span>`
              : `<span class="shrink-0 rounded-full border border-secondary/30 bg-secondary/10 px-3 py-1.5 font-inter text-[12.5px] font-semibold text-secondary">Míralo</span>`;

        const celda = (etiqueta: string, valor: string) => `
          <div>
            <p class="font-karla text-[11px] uppercase tracking-[0.1em] text-[#6f6f6f]">${etiqueta}</p>
            <p class="mt-0.5 font-karla text-[13.5px] text-[#c9c7c4]">${escapar(valor || "—")}</p>
          </div>`;

        const abierto = abiertos.has(r.archivo);
        const cuerpo = r.error
          ? `<p class="mt-3 font-karla text-sm leading-relaxed text-[#ef5350]">${escapar(r.error)}</p>`
          : `<div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
               ${celda("Tipo", r.tipo)}
               ${celda("Lado", ETIQUETA_LADO[r.lado] ?? r.lado)}
               ${celda("Minecraft", r.minecraft)}
               ${celda("Cargador", r.cargador === "?" ? "" : r.cargador)}
             </div>
             <button type="button" data-evidencia="${escapar(r.archivo)}" class="mt-4 font-karla text-[12.5px] text-[#6f6f6f] underline underline-offset-4 transition-colors hover:text-secondary">
               ${abierto ? "Ocultar en qué nos basamos" : "Ver en qué nos basamos"}
             </button>
             ${
               abierto
                 ? `<div class="mt-3 rounded-lg border border-[#1f1f1f] bg-[#0f0f0f] p-4">
                      <ul class="flex flex-col gap-2">
                        ${r.evidencias.map((e) => `<li class="flex gap-2.5 font-karla text-[13.5px] leading-relaxed text-[#9a9a9a]"><span class="text-secondary">·</span><span>${escapar(e)}</span></li>`).join("")}
                      </ul>
                    </div>`
                 : ""
             }`;

        return `
          <div class="rounded-[14px] border border-[#1f1f1f] bg-[#111111] p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="truncate font-inter text-[15px] font-semibold text-[#f3f1ef]">${escapar(r.archivo)}</p>
                ${r.nombreMod && r.nombreMod !== r.archivo ? `<p class="mt-0.5 truncate font-karla text-[13px] text-[#6f6f6f]">${escapar(r.nombreMod)}</p>` : ""}
              </div>
              ${insignia}
            </div>
            ${cuerpo}
          </div>`;
      })
      .join("");

    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-evidencia]")) {
      b.addEventListener("click", () => {
        const clave = b.dataset.evidencia!;
        abiertos.has(clave) ? abiertos.delete(clave) : abiertos.add(clave);
        pintarResultados();
      });
    }
  }

  // --- análisis ------------------------------------------------------------

  async function analizar() {
    if (!archivos.length) return;
    analisis = [];
    abiertos.clear();
    $("resultados").classList.add("hidden");
    $("progreso").classList.remove("hidden");

    for (let i = 0; i < archivos.length; i++) {
      $("progreso-texto").textContent = `${i + 1} de ${archivos.length}`;
      $("progreso-barra").style.width = `${Math.round((i / archivos.length) * 100)}%`;
      // Deja respirar al navegador para que la barra se vea avanzar.
      await new Promise((r) => setTimeout(r, 0));
      analisis.push(await analizarJar(archivos[i]));
    }

    $("progreso-barra").style.width = "100%";
    $("progreso").classList.add("hidden");
    pintarResultados();
    $("resultados").scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // --- eventos -------------------------------------------------------------

  zona.addEventListener("click", () => entrada.click());
  zona.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      entrada.click();
    }
  });
  entrada.addEventListener("change", () => {
    anadir(entrada.files);
    entrada.value = "";
  });

  for (const evento of ["dragenter", "dragover"] as const) {
    zona.addEventListener(evento, (e) => {
      e.preventDefault();
      zona.classList.add("border-secondary", "bg-[#160f06]");
    });
  }
  for (const evento of ["dragleave", "drop"] as const) {
    zona.addEventListener(evento, () => zona.classList.remove("border-secondary", "bg-[#160f06]"));
  }
  zona.addEventListener("drop", (e) => {
    e.preventDefault();
    anadir(e.dataTransfer?.files ?? null);
  });

  $("vaciar").addEventListener("click", () => {
    archivos = [];
    analisis = [];
    $("resultados").classList.add("hidden");
    mostrarErrores([]);
    pintar();
  });
  $("analizar").addEventListener("click", analizar);

  pintar();
</script>
