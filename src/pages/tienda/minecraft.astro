---
import MainLayout from "@layouts/MainLayout.astro";
import "@/styles/global.css";
import HeroTienda from "@components/sections/pages/HeroTienda.astro";
import ProductSection from "@components/sections/products/ProductSection.astro";
import Gamas from "@components/sections/products/Gamas.astro";
import FAQSection from "@components/sections/pages/FAQSection.astro";
import DedicatedSection from "@components/sections/servers/DedicatedSection.astro";
import SupportBanner from "@components/ui/SupportBanner.astro";
import ServerMap from "@components/sections/servers/ServerMap.astro";
import ConsoleSection from "@components/sections/servers/ConsoleSection.astro";
import { productTiers } from "@data/products";
import { productSchema, faqSchema, breadcrumbSchema } from "@data/seo";

// Precios de los 18 planes que renderiza esta página (3 gamas x 6 planes)
const allPrices = Object.values(productTiers).flatMap((tier) =>
  tier.products.map((product) => product.price)
);

const schemas = [
  productSchema({
    name: "Hosting de servidores de Minecraft",
    description:
      "Servidores de Minecraft en España con anti-DDoS, mods y plugins. Planes Budget, Normal y Premium de 1 a 16 GB de RAM.",
    path: "/tienda/minecraft",
    image: "/images/tienda/minecraft/mc-bg.webp",
    prices: allPrices,
  }),
  breadcrumbSchema([
    { name: "Inicio", path: "/" },
    { name: "Tienda", path: "/tienda/tienda" },
    { name: "Minecraft", path: "/tienda/minecraft" },
  ]),
];

const faqs = [
  {
    question: "¿Qué métodos de pago aceptan?",
    answer:
      "En Vhost puedes pagar con tarjeta de crédito, PayPal y Bizum. El pago es mensual y sin permanencia.",
  },
  {
    question: "¿Cuánto tarda en llegar mi servidor?",
    answer:
      "La instalación en Vhost es instantánea: el servidor se crea automáticamente tras el pago y recibes los datos de acceso al panel por correo en unos minutos.",
  },
  {
    question: "¿Por qué debería elegir Vhost?",
    answer:
      "Vhost combina hardware moderno, protección anti-DDoS incluida, soporte 24/7 en español y precios desde 0,75 €/mes, con nodos propios en España.",
  },
  {
    question: "¿Se puede instalar mods o plugins en los servidores?",
    answer:
      "Sí. Todos los servidores de Vhost incluyen acceso FTP y gestor de archivos en el panel para instalar los mods y plugins que quieras (Forge, Fabric, Spigot, Paper...).",
  },
  {
    question: "¿Los servidores funcionan con Minecraft Bedrock?",
    answer:
      "Sí, los servidores de Minecraft de Vhost soportan tanto Java Edition como Bedrock Edition.",
  },
  {
    question: "¿Puedo subir mi propio mundo al servidor?",
    answer:
      "Sí. Puedes subir tu mundo directamente desde la sección Archivos del panel de Vhost, sin necesidad de FTP externo.",
  },
  {
    question: "¿Actualmente estoy con otro hosting, puedo migrarme a Vhost?",
    answer:
      "Sí, Vhost ofrece migración gratuita: nuestro equipo traslada tu servidor desde tu hosting actual sin que pierdas datos ni configuración.",
  },
  {
    question: "¿Qué plan debería elegir?",
    answer:
      "Para Minecraft vanilla con pocos jugadores basta con 2-4 GB de RAM; con mods o más de 10 jugadores conviene 8 GB o más. Compara las gamas Budget, Normal y Premium o pregúntanos en Discord.",
  },
  {
    question: "¿Qué garantía de disponibilidad ofrecen?",
    answer:
      "Vhost garantiza un 99,9 % de uptime con monitorización 24/7 y protección anti-DDoS en todos los planes.",
  },
  {
    question: "¿Realizan copias de seguridad automáticas?",
    answer:
      "Sí, Vhost ofrece backups diarios automáticos opcionales para proteger tus mundos y archivos.",
  },
];
---

<MainLayout
  title="Hosting de Servidores de Minecraft desde 0,75 €"
  description="Servidores de Minecraft en España con anti-DDoS, mods y plugins. Planes Budget, Normal y Premium de 1 a 16 GB de RAM desde 0,75 €/mes. Actívalo en minutos."
  schemas={[...schemas, faqSchema(faqs)]}
>
  <HeroTienda
    titulo="Minecraft Hosting"
    descripcion="El hosting de Minecraft de Vhost ofrece servidores en España con protección anti-DDoS, soporte para mods y plugins, y planes de 1 a 16 GB de RAM desde 0,75 €/mes."
    imagenFondo="/images/tienda/minecraft/mc-bg.webp"
  />

  <!--  Fondo solo para esta sección -->
  <section class="relative bg-[#0b0b0b] text-white py-12 px-4">
    <!-- Título, subtítulo y enlace -->
    <div class="text-center mt-12 mb-6">
      <h2 class="text-3xl font-poppins font-semibold text-white">
        Comparar tipos de planes
      </h2>
      <p class="text-gray-300 font-poppins mt-1">
        Selecciona una gama para ver sus características y precios.
      </p>
      <a
        href="#gamas"
        id="scroll-to-gamas"
        class="mt-2 inline-block text-secondary underline font-poppins transition-colors duration-300 hover:text-[#e07600]"
      >
        Ver características
      </a>
    </div>

    <div class="relative z-10">
      <!-- Interruptor tipo toggle 3 posiciones -->
      <div class="flex justify-center my-6">
        <div
          class="relative inline-flex bg-[#1a1a1a] rounded-full text-lg font-poppins font-semibold text-white w-[21rem] h-12 items-center"
          role="tablist"
          aria-label="Selector de planes"
        >
          <!-- Indicador deslizante (1/3 del ancho) -->
          <div
            id="toggle-indicator"
            class="absolute top-0 left-0 h-full w-1/3 rounded-full bg-[#fc7c04] transition-all duration-300 z-0"
          >
          </div>

          <!-- Botón Budget -->
          <button
            id="btn-budget"
            role="tab"
            aria-selected="true"
            class="relative z-10 w-1/3 h-full rounded-full transition-colors duration-300 focus:outline-none"
          >
            Budget
          </button>

          <!-- Botón Normal -->
          <button
            id="btn-normal"
            role="tab"
            aria-selected="false"
            class="relative z-10 w-1/3 h-full rounded-full transition-colors duration-300 focus:outline-none text-white"
          >
            Normal
          </button>

          <!-- Botón Premium -->
          <button
            id="btn-premium"
            role="tab"
            aria-selected="false"
            class="relative z-10 w-1/3 h-full rounded-full transition-colors duration-300 focus:outline-none text-white"
          >
            Premium
          </button>
        </div>
      </div>

      <!-- Secciones -->
      <div
        id="budget-section"
        class="transition-opacity duration-200 ease-in-out opacity-100"
      >
        <ProductSection tier="budget" />
        <DedicatedSection />
      </div>

      <div
        id="normal-section"
        class="transition-opacity duration-200 ease-in-out opacity-0 hidden"
      >
        <ProductSection tier="normal" />
        <DedicatedSection />
      </div>

      <div
        id="premium-section"
        class="transition-opacity duration-200 ease-in-out opacity-0 hidden"
      >
        <ProductSection tier="premium" />
        <DedicatedSection />
      </div>
    </div>
  </section>
  <ConsoleSection
    title="Gestiona tu servidor de Minecraft"
    description="Instala plugins, sube mods, haz backups y controla la consola en tiempo real desde nuestro panel Pterodactyl. Sin ssh, sin complicaciones."
    glowTo="green-600"
    consolePath="root@vhost-node:~/minecraft-server"
    consoleCommand="/gamemode creative Steve"
    features={[
      {
        icon: "fa-terminal",
        title: "Consola en Vivo",
        description:
          "Ejecuta comandos y ve el output del servidor en tiempo real desde la web.",
      },
      {
        icon: "fa-puzzle-piece",
        title: "Plugins & Mods",
        description:
          "Instala Spigot, Paper, Forge o Fabric con un clic desde el panel.",
      },
      {
        icon: "fa-cloud-upload-alt",
        title: "Backups Automáticos",
        description:
          "Copia de seguridad diaria de tu mundo. Restaura en segundos si algo sale mal.",
      },
      {
        icon: "fa-users-cog",
        title: "Sub-usuarios",
        description:
          "Da acceso a tus admins con permisos específicos sin compartir tu contraseña.",
      },
    ]}
    consoleLogs={[
      {
        time: "08:00:01",
        level: "SYSTEM",
        message: "Starting Minecraft server (Paper 1.21.1)...",
      },
      {
        time: "08:00:02",
        level: "INFO",
        message: 'Loading world <span class="text-green-500">"world"</span>...',
      },
      {
        time: "08:00:03",
        level: "INFO",
        message:
          'Loaded 128 chunks in <span class="text-green-500">0.8s</span>.',
      },
      {
        time: "08:00:03",
        level: "INFO",
        message: "Loading plugins: EssentialsX, WorldEdit, LuckPerms...",
      },
      {
        time: "08:00:04",
        level: "INFO",
        message: 'Plugins loaded: <span class="text-green-500">3/3 OK</span>.',
      },
      {
        time: "08:00:05",
        level: "INFO",
        message:
          'Done! For help, type <span class="text-yellow-400">"help"</span>.',
      },
      {
        time: "08:00:06",
        level: "SUCCESS",
        message:
          'Server is UP — listening on port <span class="text-yellow-400">25565</span>!',
      },
    ]}
  />
  <ServerMap />
  <Gamas />
  <SupportBanner />
  <FAQSection items={faqs} inviteLink="https://discord.gg/Ykr85wevrj" />

  <!-- Script -->
  <script is:inline>
    const btnBudget = document.getElementById("btn-budget");
    const btnNormal = document.getElementById("btn-normal");
    const btnPremium = document.getElementById("btn-premium");
    const toggleIndicator = document.getElementById("toggle-indicator");

    const budgetSection = document.getElementById("budget-section");
    const normalSection = document.getElementById("normal-section");
    const premiumSection = document.getElementById("premium-section");

    const scrollLink = document.getElementById("scroll-to-gamas");
    const DURATION = 200;

    const plans = ["budget", "normal", "premium"];
    const sections = {
      budget: budgetSection,
      normal: normalSection,
      premium: premiumSection,
    };
    const buttons = {
      budget: btnBudget,
      normal: btnNormal,
      premium: btnPremium,
    };

    function fadeTo(showEl, ...hideEls) {
      hideEls.forEach((el) => {
        el.classList.remove("opacity-100");
        el.classList.add("opacity-0");
        setTimeout(() => {
          el.classList.add("hidden");
        }, DURATION);
      });

      showEl.classList.remove("hidden");
      // Forzar dos frames para transición suave
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          showEl.classList.remove("opacity-0");
          showEl.classList.add("opacity-100");
        });
      });
    }

    function setActive(plan) {
      // Mover indicador: 0%, 33.333%, 66.666%
      const index = plans.indexOf(plan);
      const leftPercent = index * (100 / 3);
      toggleIndicator.style.left = leftPercent + "%";

      // Actualizar secciones
      const toShow = sections[plan];
      const toHide = plans.filter((p) => p !== plan).map((p) => sections[p]);
      fadeTo(toShow, ...toHide);

      // Actualizar colores y aria-selected
      plans.forEach((p) => {
        const btn = buttons[p];
        const selected = p === plan;
        btn.setAttribute("aria-selected", selected ? "true" : "false");
        if (selected) {
          btn.classList.add("text-black");
          btn.classList.remove("text-white");
        } else {
          btn.classList.remove("text-black");
          btn.classList.add("text-white");
        }
      });
    }

    // Eventos de click
    btnBudget.addEventListener("click", () => setActive("budget"));
    btnNormal.addEventListener("click", () => setActive("normal"));
    btnPremium.addEventListener("click", () => setActive("premium"));

    // Navegación con teclado (izq/der) para accesibilidad
    const order = [btnBudget, btnNormal, btnPremium];
    order.forEach((btn, i) => {
      btn.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight") {
          e.preventDefault();
          order[(i + 1) % order.length].focus();
          order[(i + 1) % order.length].click();
        } else if (e.key === "ArrowLeft") {
          e.preventDefault();
          order[(i - 1 + order.length) % order.length].focus();
          order[(i - 1 + order.length) % order.length].click();
        }
      });
    });

    // Estado inicial
    setActive("budget");

    // Scroll suave a "gamas"
    scrollLink.addEventListener("click", (e) => {
      e.preventDefault();
      const gamasSection = document.getElementById("gamas");
      if (gamasSection) {
        gamasSection.scrollIntoView({ behavior: "smooth" });
      }
    });
  </script>
</MainLayout>
